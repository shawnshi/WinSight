<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WinSight.Ui.Harness</RootNamespace>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <StartupObject>WinSight.Ui.Harness.HarnessProgram</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Match product WinAppSDK deployment without bundling the .NET runtime. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- An Application root must own the generated XAML metadata provider. -->
    <Page Remove="HarnessApp.xaml" />
    <ApplicationDefinition Include="HarnessApp.xaml" />
    <ProjectReference Include="..\..\src\WinSight.Core\WinSight.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\WinSight.App\Services\*.cs" Link="AppServices\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\WinSight.App\ViewModels\*.cs" Link="AppViewModels\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\WinSight.App\Views\*.xaml.cs" Exclude="..\..\src\WinSight.App\Views\QuickSearchWindow.xaml.cs" Link="AppViews\%(Filename)%(Extension)" />
    <Page Include="..\..\src\WinSight.App\Views\*.xaml" Exclude="..\..\src\WinSight.App\Views\QuickSearchWindow.xaml" Link="AppViews\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="[2.5.1]" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="[10.0.26100.9169]" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\..\Resources\AppIcon\WinSight.ico" Link="Assets\WinSight.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\Resources\AppIcon\128x128.png" Link="Assets\WinSight.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
