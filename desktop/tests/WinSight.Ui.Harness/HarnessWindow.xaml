<Window
    x:Class="WinSight.Ui.Harness.HarnessWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="WinSight UI Test Harness (Synthetic)">

    <!-- Solid opaque background to prevent any desktop leakage -->
    <Grid Background="#1E1E1E" Padding="20" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Text="WinSight Native UI Synthetic Test Harness"
                       Foreground="#FFFFFF"
                       FontSize="20"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Test-only harness verifying WinUI 3 views, ViewModels, services, hotkeys, tray, single-instance, and lifecycle."
                       Foreground="#A0AAB5"
                       FontSize="13"/>
        </StackPanel>

        <!-- Test Results Log -->
        <Border Grid.Row="1"
                Background="#252526"
                BorderBrush="#3E3E42"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
            <ScrollViewer x:Name="LogScrollViewer">
                <TextBox x:Name="LogTextBox"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         FontFamily="Consolas, monospace"
                         FontSize="12"
                         Foreground="#D4D4D4"
                         Background="Transparent"
                         BorderThickness="0"/>
            </ScrollViewer>
        </Border>

        <!-- Footer Actions -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="SummaryTextBlock"
                       Text="Ready to run tests..."
                       Foreground="#4EC9B0"
                       FontSize="13"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Content="Run All Synthetic Tests"
                    Click="OnRunTestsClick"
                    Background="#005EB8"
                    Foreground="#FFFFFF"/>

            <Button Grid.Column="2"
                    Content="Close"
                    Click="OnCloseClick"
                    Foreground="#FFFFFF"/>
        </Grid>
    </Grid>
</Window>
