<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile only the exclusive slice: no shared project build/obj writes. -->
    <Compile Include="../../src/WinSight.Core/Contracts.cs" Link="Core/Contracts.cs" />
    <Compile Include="../../src/WinSight.Infrastructure/Storage/**/*.cs" Link="Storage/%(Filename)%(Extension)" />
    <Compile Include="../../src/WinSight.Infrastructure/Search/**/*.cs" Link="Search/%(Filename)%(Extension)" />
    <!-- S1 queue semantics live in Indexing; the queue deliberately has no runtime dependency. -->
    <Compile Include="../../src/WinSight.Infrastructure/Indexing/IncrementalIndexQueue.cs" Link="Indexing/IncrementalIndexQueue.cs" />
    <Compile Include="../../src/WinSight.Infrastructure/Indexing/UsnJournal.cs" Link="Indexing/UsnJournal.cs" />
    <Compile Include="../../src/WinSight.Infrastructure/Extraction/FilePolicy.cs" Link="Extraction/FilePolicy.cs" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="[10.0.13]" />
  </ItemGroup>
</Project>
