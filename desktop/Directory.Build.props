<Project>
  <PropertyGroup>
    <!-- Single product version for the app, CLI, bridge and tests; the installer and the update check read it. -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix></VersionSuffix>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- The exact SDK pin selects the RC2 runtime. A global RuntimeFrameworkVersion also overrides Windows SDK targeting references. -->
    <RollForward>Disable</RollForward>
  </PropertyGroup>
</Project>
