<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>winsight-mcp</AssemblyName>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <RollForward>Disable</RollForward>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../WinSight.Infrastructure/WinSight.Infrastructure.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="[10.0.13]" />
    <!-- Required, not optional: a silently missing segmenter would report every lexical search as degraded. -->
    <None Include="../../../native/winsight-segmenter/target/release/winsight_segmenter.dll"
          Link="runtimes/win-x64/native/winsight_segmenter.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
