<Page
    x:Class="WinSight.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="24" MaxWidth="800" HorizontalAlignment="Left">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="系统设置" Style="{ThemeResource TitleTextBlockStyle}"/>
                <TextBlock Text="配置快捷键、后台索引计划、界面外观与系统行为。"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- Hotkey Section -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="全局快捷键" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="从 Windows 任何位置呼出快捷搜索栏的全局键盘快捷键。"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="HotkeyBox"
                                 Text="{x:Bind ViewModel.Hotkey, Mode=TwoWay}"
                                 PlaceholderText="e.g. Control+Shift+Space"
                                 VerticalAlignment="Center"/>

                        <Button Grid.Column="1"
                                Content="应用快捷键"
                                Click="OnApplyHotkeyClick"
                                VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Conflict Warning Banner -->
                    <InfoBar IsOpen="{x:Bind ViewModel.HasHotkeyConflict, Mode=OneWay}"
                             Severity="Warning"
                             Title="快捷键注册冲突"
                             Message="{x:Bind ViewModel.HotkeyConflictMessage, Mode=OneWay}"
                             IsClosable="False"/>
                </StackPanel>
            </Border>

            <!-- Background Indexing & Schedule Section -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="索引与计划" Style="{ThemeResource SubtitleTextBlockStyle}"/>

                    <!-- Background monitoring -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="后台监听与增量索引" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="自动监听目录变动并在系统空闲时运行防抖增量队列。"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsOn="{x:Bind ViewModel.BackgroundIndexingEnabled, Mode=TwoWay}"/>
                    </Grid>

                    <!-- Index Hours Toggle -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="限制在指定时间段内索引" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="将重型索引限制在非高峰时段（自午夜起的分钟数）。"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsOn="{x:Bind ViewModel.IndexHoursOn, Mode=TwoWay}"/>
                    </Grid>

                    <!-- Hours Inputs (in minutes since midnight) -->
                    <Grid ColumnSpacing="16" RowSpacing="8" Visibility="{x:Bind BoolToVisibility(ViewModel.IndexHoursOn), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="开始时间（自午夜起的分钟数，例如 60 即 01:00）：" Style="{ThemeResource CaptionTextBlockStyle}"/>
                            <NumberBox Value="{x:Bind ViewModel.IndexHoursStart, Mode=TwoWay}"
                                       Minimum="0" Maximum="1439" SmallChange="15" SpinButtonPlacementMode="Inline"/>
                            <TextBlock Text="{x:Bind ViewModel.IndexHoursStartFormatted, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="结束时间（自午夜起的分钟数，例如 420 即 07:00）：" Style="{ThemeResource CaptionTextBlockStyle}"/>
                            <NumberBox Value="{x:Bind ViewModel.IndexHoursEnd, Mode=TwoWay}"
                                       Minimum="0" Maximum="1439" SmallChange="15" SpinButtonPlacementMode="Inline"/>
                            <TextBlock Text="{x:Bind ViewModel.IndexHoursEndFormatted, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Processor Only -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="仅在使用交流电源时自动索引" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="使用电池或未知电源时暂停自动索引，断开电源后 30 秒内自动暂停。手动索引仍保持可用。"
                                       TextWrapping="Wrap"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      AutomationProperties.AutomationId="AcOnlyIndexingToggle"
                                      AutomationProperties.Name="Automatic indexing on AC power only"
                                      IsOn="{x:Bind ViewModel.ProcessorOnly, Mode=TwoWay}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Appearance & Integration Section -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="外观与系统集成" Style="{ThemeResource SubtitleTextBlockStyle}"/>

                    <!-- Theme Selection -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="应用主题" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="选择跟随系统、浅色或深色模式。"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  x:Name="ThemeComboBox"
                                  SelectionChanged="OnThemeSelectionChanged">
                            <ComboBoxItem Content="跟随系统"/>
                            <ComboBoxItem Content="浅色"/>
                            <ComboBoxItem Content="深色"/>
                        </ComboBox>
                    </Grid>

                    <!-- Tray Click Action -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="托盘图标单击行为" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="单击任务栏托盘图标时触发的操作。"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  x:Name="TrayClickComboBox"
                                  SelectionChanged="OnTrayClickSelectionChanged">
                            <ComboBoxItem Content="呼出快捷搜索栏"/>
                            <ComboBoxItem Content="打开主窗口"/>
                        </ComboBox>
                    </Grid>

                    <!-- Code Editor Choice -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="首选代码编辑器" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="打开代码搜索结果时使用的外部编辑器。"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  x:Name="CodeEditorComboBox"
                                  SelectionChanged="OnCodeEditorSelectionChanged">
                            <ComboBoxItem Content="系统默认程序"/>
                            <ComboBoxItem Content="Visual Studio Code (code)"/>
                        </ComboBox>
                    </Grid>

                    <!-- Open At Login -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="开机自动启动" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="登录 Windows 时在系统托盘启动（仅当前用户登录项，不修改系统全局项）。"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsOn="{x:Bind ViewModel.OpenAtLogin, Mode=TwoWay}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Hardware & Inference Acceleration Section -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="AI 与硬件加速" Style="{ThemeResource SubtitleTextBlockStyle}"/>

                    <!-- Accelerator Selection -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="加速设备选择" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="选择用于向量嵌入与模型推理的硬件设备。"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  x:Name="AcceleratorComboBox"
                                  AutomationProperties.AutomationId="AcceleratorComboBox"
                                  AutomationProperties.Name="Acceleration device"
                                  SelectionChanged="OnAcceleratorSelectionChanged">
                            <ComboBoxItem Content="自动选择 (优先独立显卡)" Tag="auto"/>
                            <ComboBoxItem Content="独立显卡 (Discrete GPU)" Tag="discrete-gpu"/>
                            <ComboBoxItem Content="神经网络处理器 (NPU)" Tag="npu"/>
                            <ComboBoxItem Content="显卡 (GPU)" Tag="gpu"/>
                            <ComboBoxItem Content="处理器 (CPU)" Tag="cpu"/>
                        </ComboBox>
                    </Grid>

                    <!-- Install Execution Providers Toggle -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="允许下载并注册执行提供程序（Foundry Local）" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="允许下载或注册适用的 DirectML、NPU 或 GPU 执行提供程序组件。"
                                       TextWrapping="Wrap"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    <TextBlock Text="索引期间生成页面图像：默认关闭。开启后支持页面级视觉检索，但会增加 Office/PDF 渲染栅格化开销。"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="NPU 在独立的 Windows ML 宿主中运行；其他选项使用默认宿主。切换加速器会触发索引代际更新，因为不同运行库拥有各自的嵌入画像。"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                        <ToggleSwitch Grid.Column="1"
                                      AutomationProperties.AutomationId="PageImagesToggle"
                                      AutomationProperties.Name="Generate page images during indexing"
                                      IsOn="{x:Bind ViewModel.GeneratePageImages, Mode=TwoWay}"/>
                        <ToggleSwitch Grid.Column="1"
                                      AutomationProperties.AutomationId="InstallExecutionProvidersToggle"
                                      AutomationProperties.Name="Allow Windows ML to install and register execution providers"
                                      IsOn="{x:Bind ViewModel.InstallExecutionProviders, Mode=TwoWay}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Models -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="模型与计算设备" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="{x:Bind ViewModel.ModelsSummary, Mode=OneWay}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="ModelsSummary"/>
                    <TextBlock Text="{x:Bind ViewModel.VectorScale, Mode=OneWay}" TextWrapping="Wrap"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               AutomationProperties.AutomationId="VectorScaleSummary"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="刷新模型状态" Click="OnRefreshModelsClick"
                                AutomationProperties.AutomationId="RefreshModelsButton"/>
                        <Button Content="评估向量规模" Click="OnMeasureVectorsClick"
                                AutomationProperties.AutomationId="MeasureVectorsButton"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Index location -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="索引存储位置" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="将索引移动至空目录。预检将先说明限制条件；迁移将导出并校验数据，随后指向新路径。原目录不会被删除。"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <TextBox Header="目标目录路径" Text="{x:Bind ViewModel.MigrationTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="D:\WinSightIndex"
                             AutomationProperties.AutomationId="MigrationTargetBox"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="预检路径" Click="OnInspectMigrationClick"
                                AutomationProperties.AutomationId="InspectMigrationButton"/>
                        <Button Content="开始迁移" Click="OnMigrateIndexClick"
                                IsEnabled="{x:Bind ViewModel.CanMigrate, Mode=OneWay}"
                                AutomationProperties.AutomationId="MigrateIndexButton"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.MigrationSummary, Mode=OneWay}" TextWrapping="Wrap"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               AutomationProperties.AutomationId="MigrationSummary"/>
                </StackPanel>
            </Border>

            <!-- Index generation -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="索引代际版本" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="{x:Bind ViewModel.RebuildSummary, Mode=OneWay}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="RebuildSummary"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="检查代际" Click="OnRefreshRebuildClick"
                                AutomationProperties.AutomationId="RefreshRebuildButton"/>
                        <Button Content="重建索引" Click="OnStartRebuildClick"
                                AutomationProperties.AutomationId="StartRebuildButton"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- MCP maintenance authorization -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="MCP 客户端维护授权" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="外部客户端不能直接写入索引：index_directory 请求将暂存在此。处理时仅授权目录内的路径会加入队列，其他路径将被明确拒绝并记录原因。"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="立即处理请求" Click="OnDrainMaintenanceClick"
                                IsEnabled="{x:Bind ViewModel.CanManageMaintenance, Mode=OneWay}"
                                AutomationProperties.AutomationId="DrainMaintenanceButton"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.MaintenanceSummary, Mode=OneWay}" TextWrapping="Wrap"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               AutomationProperties.AutomationId="MaintenanceSummary"/>
                </StackPanel>
            </Border>

            <!-- MCP client configuration -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="连接 MCP 客户端" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="选择一个客户端配置文件。预览将显示变更内容；应用前会自动备份原文件，并添加 bridge 路径与 --stdio。不会明文写入令牌，若存在冲突项则会被拒绝。"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <RadioButton Content="stdio 进程管道 (推荐)" GroupName="ClientTransport"
                                     IsChecked="{x:Bind ViewModel.UseStdioTransport, Mode=TwoWay}"
                                     AutomationProperties.AutomationId="TransportStdioRadio"/>
                        <RadioButton Content="环回 HTTP" GroupName="ClientTransport"
                                     IsChecked="{x:Bind ViewModel.UseHttpTransport, Mode=TwoWay}"
                                     AutomationProperties.AutomationId="TransportHttpRadio"/>
                        <TextBox Header="HTTP 端口" Width="110" Text="{x:Bind ViewModel.HttpPortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="HttpPortBox"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.ClientTransportDescription, Mode=OneWay}" TextWrapping="Wrap"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               AutomationProperties.AutomationId="ClientTransportDescription"/>
                    <TextBox Header="客户端配置文件路径"
                             Text="{x:Bind ViewModel.ClientConfigPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="C:\path	o\client-config.json"
                             AutomationProperties.AutomationId="ClientConfigPathBox"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="预览配置" Click="OnPreviewClientConfigClick"
                                IsEnabled="{x:Bind ViewModel.CanConfigureClient, Mode=OneWay}"
                                AutomationProperties.AutomationId="PreviewClientConfigButton"/>
                        <Button Content="应用配置" Click="OnApplyClientConfigClick"
                                IsEnabled="{x:Bind ViewModel.CanConfigureClient, Mode=OneWay}"
                                AutomationProperties.AutomationId="ApplyClientConfigButton"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.ClientConfigSummary, Mode=OneWay}" TextWrapping="Wrap"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               AutomationProperties.AutomationId="ClientConfigSummary"/>
                </StackPanel>
            </Border>

            <!-- NPU (isolated Windows ML host) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="NPU 执行宿主 (Windows ML)" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="运行于 Windows ML 专属 ONNX Runtime (1.27) 的独立进程。注册本机已有的厂商 NPU 运行库并探测可用设备。"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{x:Bind ViewModel.NpuSummary, Mode=OneWay}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="NpuSummary"/>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.NpuDevices, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{x:Bind ViewModel.NpuQualification, Mode=OneWay}" TextWrapping="Wrap"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               AutomationProperties.AutomationId="NpuQualification"/>
                    <Button Content="探测 NPU 宿主" Click="OnProbeNpuClick"
                            IsEnabled="{x:Bind ViewModel.CanProbeNpu, Mode=OneWay}"
                            AutomationProperties.AutomationId="ProbeNpuButton"/>
                </StackPanel>
            </Border>

            <!-- Foundry Local (isolated backend) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="Foundry Local 后端" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="集成 Foundry Local 运行时 (ORT 1.31) 的独立进程。探测操作仅发现可用提供程序，不产生下载。"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{x:Bind ViewModel.FoundrySummary, Mode=OneWay}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="FoundrySummary"/>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.FoundryProviders, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="探测 Foundry 状态" Click="OnProbeFoundryClick"
                                AutomationProperties.AutomationId="ProbeFoundryButton"/>
                        <Button Content="安装适用提供程序" Click="OnInstallFoundryProvidersClick"
                                IsEnabled="{x:Bind ViewModel.CanInstallFoundryProviders, Mode=OneWay}"
                                AutomationProperties.AutomationId="InstallFoundryProvidersButton"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="关于 WinSight" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <Grid ColumnSpacing="16" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="当前版本" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}"
                                   AutomationProperties.AutomationId="AboutVersion" IsTextSelectionEnabled="True"/>
                        <TextBlock Grid.Row="1" Text="开源主页" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <HyperlinkButton Grid.Row="1" Grid.Column="1"
                                         Content="{x:Bind ViewModel.RepositoryUrl}"
                                         NavigateUri="{x:Bind ViewModel.RepositoryUrl}"
                                         AutomationProperties.AutomationId="AboutRepositoryLink"
                                         Padding="0"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="导出诊断日志包"
                                AutomationProperties.AutomationId="ExportDiagnosticsButton"
                                Click="OnExportDiagnosticsClick"/>
                        <TextBlock x:Name="DiagnosticsStatus"
                                   VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="DiagnosticsStatus"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBox Header="更新检查源地址 (可选，仅限 https)"
                             Text="{x:Bind ViewModel.UpdateFeedUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="https://example.org/winsight/update.json"
                             AutomationProperties.AutomationId="UpdateFeedUrlBox"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="检查更新"
                                AutomationProperties.AutomationId="CheckForUpdatesButton"
                                Click="OnCheckForUpdatesClick"/>
                        <HyperlinkButton x:Name="UpdateLink" Visibility="Collapsed" Content="前往下载页面"
                                         AutomationProperties.AutomationId="UpdateDownloadLink"/>
                        <TextBlock x:Name="UpdateStatus"
                                   VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="UpdateStatus"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Text="当前为本地开发预览版，非正式稳定发行版。历史旧索引不会自动迁移。"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Save Button and Feedback -->
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Button Content="保存设置"
                        Style="{ThemeResource AccentButtonStyle}"
                        Click="OnSaveSettingsClick"/>
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                           VerticalAlignment="Center"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
