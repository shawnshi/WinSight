<Page
    x:Class="WinSight.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="20" MaxWidth="{StaticResource WsPageMaxWidth}" HorizontalAlignment="Left">
            <!-- Header + Live Auto-Save Status -->
            <Grid ColumnSpacing="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="系统设置" Style="{ThemeResource TitleTextBlockStyle}"/>
                    <TextBlock Text="配置全局快捷键、后台索引计划、外观主题与 AI 硬件加速（开关与选择器即改即存）。"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            </Grid>

            <!-- Hotkey Section with Key Recorder -->
            <Border Style="{StaticResource WsCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="全局快捷键" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="从 Windows 任何位置呼出快捷搜索栏的全局快捷键（支持点击录制后直接按下组合键）。"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="HotkeyBox"
                                 Text="{x:Bind ViewModel.Hotkey, Mode=TwoWay}"
                                 PlaceholderText="例如 Control+Shift+Space"
                                 PreviewKeyDown="OnHotkeyBoxPreviewKeyDown"
                                 VerticalAlignment="Center"/>

                        <ToggleButton x:Name="RecordHotkeyButton" Grid.Column="1"
                                      Content="按下组合键录制"
                                      Checked="OnRecordHotkeyChecked"
                                      Unchecked="OnRecordHotkeyUnchecked"
                                      CornerRadius="6" VerticalAlignment="Center"/>

                        <Button Grid.Column="2"
                                Content="应用快捷键"
                                Style="{ThemeResource AccentButtonStyle}"
                                CornerRadius="6"
                                Click="OnApplyHotkeyClick"
                                VerticalAlignment="Center"/>
                    </Grid>

                    <InfoBar IsOpen="{x:Bind ViewModel.HasHotkeyConflict, Mode=OneWay}"
                             Severity="Warning"
                             Title="快捷键注册冲突"
                             Message="{x:Bind ViewModel.HotkeyConflictMessage, Mode=OneWay}"
                             IsClosable="False"/>
                </StackPanel>
            </Border>

            <!-- Background Indexing & Schedule Section -->
            <Border Style="{StaticResource WsCardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="索引与计划" Style="{ThemeResource SubtitleTextBlockStyle}"/>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="后台监听与增量索引" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="自动监听目录变动并在系统空闲时运行防抖增量队列。"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsOn="{x:Bind ViewModel.BackgroundIndexingEnabled, Mode=TwoWay}"
                                      Toggled="OnAutoSaveToggled"/>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="限制在指定时段内自动索引" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="将重型索引限制在设定的起止时间窗口内运行（24 小时制）。"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsOn="{x:Bind ViewModel.IndexHoursOn, Mode=TwoWay}"
                                      Toggled="OnAutoSaveToggled"/>
                    </Grid>

                    <!-- Native WinUI 3 24-Hour TimePickers -->
                    <Grid ColumnSpacing="16" Visibility="{x:Bind BoolToVisibility(ViewModel.IndexHoursOn), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TimePicker x:Name="StartTimePicker" Grid.Column="0" Header="开始时间"
                                    ClockIdentifier="24HourClock" MinuteIncrement="15"
                                    TimeChanged="OnScheduleTimeChanged" HorizontalAlignment="Stretch"/>
                        <TimePicker x:Name="EndTimePicker" Grid.Column="1" Header="结束时间"
                                    ClockIdentifier="24HourClock" MinuteIncrement="15"
                                    TimeChanged="OnScheduleTimeChanged" HorizontalAlignment="Stretch"/>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="仅在使用交流电源时自动索引" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="使用电池或未知电源时暂停自动索引，断开电源后 30 秒内自动暂停。手动索引仍保持可用。"
                                       TextWrapping="Wrap"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      AutomationProperties.AutomationId="AcOnlyIndexingToggle"
                                      AutomationProperties.Name="Automatic indexing on AC power only"
                                      IsOn="{x:Bind ViewModel.ProcessorOnly, Mode=TwoWay}"
                                      Toggled="OnAutoSaveToggled"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Appearance & Integration Section -->
            <Border Style="{StaticResource WsCardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="外观与系统集成" Style="{ThemeResource SubtitleTextBlockStyle}"/>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="应用主题" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="选择跟随系统、浅色或深色模式。"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="ThemeComboBox" SelectionChanged="OnThemeSelectionChanged">
                            <ComboBoxItem Content="跟随系统" Tag="Default"/>
                            <ComboBoxItem Content="浅色" Tag="Light"/>
                            <ComboBoxItem Content="深色" Tag="Dark"/>
                        </ComboBox>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="托盘图标单击行为" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="单击任务栏托盘图标时触发的操作。"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="TrayClickComboBox" SelectionChanged="OnTrayClickSelectionChanged">
                            <ComboBoxItem Content="呼出快捷搜索栏" Tag="panel"/>
                            <ComboBoxItem Content="打开主窗口" Tag="window"/>
                        </ComboBox>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="首选代码编辑器" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="打开代码搜索结果时使用的外部编辑器。"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="CodeEditorComboBox" SelectionChanged="OnCodeEditorSelectionChanged">
                            <ComboBoxItem Content="系统默认程序 (记事本)" Tag="default"/>
                            <ComboBoxItem Content="Visual Studio Code (code)" Tag="vscode"/>
                            <ComboBoxItem Content="Cursor (cursor)" Tag="cursor"/>
                            <ComboBoxItem Content="Windsurf (windsurf)" Tag="windsurf"/>
                            <ComboBoxItem Content="Notepad++ (notepad++)" Tag="notepad++"/>
                            <ComboBoxItem Content="Sublime Text (subl)" Tag="sublime"/>
                        </ComboBox>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="开机自动启动" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="登录 Windows 时在系统托盘静默启动（仅当前用户启动项）。"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsOn="{x:Bind ViewModel.OpenAtLogin, Mode=TwoWay}"
                                      Toggled="OnAutoSaveToggled"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Hardware & Inference Acceleration Section -->
            <Border Style="{StaticResource WsCardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="AI 与硬件加速" Style="{ThemeResource SubtitleTextBlockStyle}"/>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="加速设备选择" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="选择用于向量嵌入与视觉编码的硬件执行设备。"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  x:Name="AcceleratorComboBox"
                                  AutomationProperties.AutomationId="AcceleratorComboBox"
                                  AutomationProperties.Name="Acceleration device"
                                  SelectionChanged="OnAcceleratorSelectionChanged">
                            <ComboBoxItem Content="自动选择 (优先独立显卡/NPU)" Tag="auto"/>
                            <ComboBoxItem Content="独立显卡 (Discrete GPU)" Tag="discrete-gpu"/>
                            <ComboBoxItem Content="神经网络处理器 (NPU)" Tag="npu"/>
                            <ComboBoxItem Content="显卡 (GPU)" Tag="gpu"/>
                            <ComboBoxItem Content="处理器 (CPU)" Tag="cpu"/>
                        </ComboBox>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="索引期间生成页面图像 (PDF / PPTX 栅格化)" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="默认关闭。开启后支持页面级视觉检索与扫描件 OCR，但会增加后台渲染耗时。"
                                       TextWrapping="Wrap"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      VerticalAlignment="Center"
                                      AutomationProperties.AutomationId="PageImagesToggle"
                                      AutomationProperties.Name="Generate page images during indexing"
                                      IsOn="{x:Bind ViewModel.GeneratePageImages, Mode=TwoWay}"
                                      Toggled="OnAutoSaveToggled"/>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="允许注册硬件执行提供程序 (Windows ML / Foundry)" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="允许自动发现并注册本机适用的 DirectML、NPU 或 GPU 硬件加速组件。"
                                       TextWrapping="Wrap"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      VerticalAlignment="Center"
                                      AutomationProperties.AutomationId="InstallExecutionProvidersToggle"
                                      AutomationProperties.Name="Allow Windows ML to install and register execution providers"
                                      IsOn="{x:Bind ViewModel.InstallExecutionProviders, Mode=TwoWay}"
                                      Toggled="OnAutoSaveToggled"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Streamlined MCP Entry Card (Links to dedicated MCP Console) -->
            <Border Style="{StaticResource WsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="AI 智能体 MCP 服务集成 (SDK 2.0)" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        <TextBlock Text="启用后可通过 MCP 控制台一键导出 Claude / Cursor / VS Code 客户端接入配置。"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button x:Name="GoMcpConsoleButton" Grid.Column="1" Content="前往 MCP 控制台"
                            CornerRadius="6" VerticalAlignment="Center" Click="OnOpenMcpConsoleClick"/>
                    <ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                  IsOn="{x:Bind ViewModel.EnableMcpServer, Mode=TwoWay}"
                                  OnContent="已启用" OffContent="已停用"
                                  Toggled="OnAutoSaveToggled"
                                  AutomationProperties.AutomationId="McpServerToggle"/>
                </Grid>
            </Border>

            <!-- Collapsible Advanced Diagnostics & Maintenance Section -->
            <Expander Header="高级存储迁移、索引代际与底层驱动诊断" IsExpanded="False" HorizontalAlignment="Stretch">
                <StackPanel Spacing="16" Margin="0,12,0,0">
                    <Border Style="{StaticResource WsCardStyle}" Padding="18">
                        <StackPanel Spacing="10">
                            <TextBlock Text="模型与计算设备规模" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="{x:Bind ViewModel.ModelsSummary, Mode=OneWay}" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="ModelsSummary"/>
                            <TextBlock Text="{x:Bind ViewModel.VectorScale, Mode=OneWay}" TextWrapping="Wrap"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       AutomationProperties.AutomationId="VectorScaleSummary"/>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Content="刷新模型状态" CornerRadius="6" Click="OnRefreshModelsClick"
                                        AutomationProperties.AutomationId="RefreshModelsButton"/>
                                <Button Content="评估向量规模" CornerRadius="6" Click="OnMeasureVectorsClick"
                                        AutomationProperties.AutomationId="MeasureVectorsButton"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource WsCardStyle}" Padding="18">
                        <StackPanel Spacing="10">
                            <TextBlock Text="索引存储目录迁移" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="将索引安全迁移至新的空目录，校验通过后自动切换路径，原目录保留作为备份。"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBox Header="目标目录路径" Text="{x:Bind ViewModel.MigrationTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="D:\WinSightIndex"
                                     AutomationProperties.AutomationId="MigrationTargetBox"/>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Content="预检路径" CornerRadius="6" Click="OnInspectMigrationClick"
                                        AutomationProperties.AutomationId="InspectMigrationButton"/>
                                <Button Content="开始迁移" CornerRadius="6" Click="OnMigrateIndexClick"
                                        IsEnabled="{x:Bind ViewModel.CanMigrate, Mode=OneWay}"
                                        AutomationProperties.AutomationId="MigrateIndexButton"/>
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.MigrationSummary, Mode=OneWay}" TextWrapping="Wrap"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       AutomationProperties.AutomationId="MigrationSummary"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource WsCardStyle}" Padding="18">
                        <StackPanel Spacing="10">
                            <TextBlock Text="索引代际版本与全量重建" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="{x:Bind ViewModel.RebuildSummary, Mode=OneWay}" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="RebuildSummary"/>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Content="检查代际" CornerRadius="6" Click="OnRefreshRebuildClick"
                                        AutomationProperties.AutomationId="RefreshRebuildButton"/>
                                <Button Content="重建索引" CornerRadius="6" Click="OnStartRebuildClick"
                                        AutomationProperties.AutomationId="StartRebuildButton"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource WsCardStyle}" Padding="18">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Windows ML / NPU 与硬件加速探针" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="{x:Bind ViewModel.NpuSummary, Mode=OneWay}" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="NpuSummary"/>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.NpuDevices, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}" Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{x:Bind ViewModel.NpuQualification, Mode=OneWay}" TextWrapping="Wrap"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       AutomationProperties.AutomationId="NpuQualification"/>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Content="探测硬件与 NPU 宿主" CornerRadius="6" Click="OnProbeNpuClick"
                                        IsEnabled="{x:Bind ViewModel.CanProbeNpu, Mode=OneWay}"
                                        AutomationProperties.AutomationId="ProbeNpuButton"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Expander>

            <!-- About -->
            <Border Style="{StaticResource WsCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="关于 WinSight" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <Grid ColumnSpacing="16" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="当前版本" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}"
                                   AutomationProperties.AutomationId="AboutVersion" IsTextSelectionEnabled="True"/>
                        <TextBlock Grid.Row="1" Text="开源主页" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <HyperlinkButton Grid.Row="1" Grid.Column="1"
                                         Content="{x:Bind ViewModel.RepositoryUrl}"
                                         NavigateUri="{x:Bind ViewModel.RepositoryUrl}"
                                         AutomationProperties.AutomationId="AboutRepositoryLink"
                                         Padding="0"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="导出诊断日志包" CornerRadius="6"
                                AutomationProperties.AutomationId="ExportDiagnosticsButton"
                                Click="OnExportDiagnosticsClick"/>
                        <TextBlock x:Name="DiagnosticsStatus"
                                   VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="DiagnosticsStatus"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBox Header="更新检查源地址 (可选，仅限 https)"
                             Text="{x:Bind ViewModel.UpdateFeedUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="https://example.org/winsight/update.json"
                             AutomationProperties.AutomationId="UpdateFeedUrlBox"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="检查更新" CornerRadius="6"
                                AutomationProperties.AutomationId="CheckForUpdatesButton"
                                Click="OnCheckForUpdatesClick"/>
                        <HyperlinkButton x:Name="UpdateLink" Visibility="Collapsed" Content="前往下载页面"
                                         AutomationProperties.AutomationId="UpdateDownloadLink"/>
                        <TextBlock x:Name="UpdateStatus"
                                   VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="UpdateStatus"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Save Button and Feedback (also auto-saves on toggle/combo/time changes) -->
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Button Content="保存全部设置"
                        Style="{ThemeResource AccentButtonStyle}"
                        CornerRadius="6"
                        Click="OnSaveSettingsClick"/>
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                           VerticalAlignment="Center"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
