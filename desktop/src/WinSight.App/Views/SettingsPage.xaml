<Page
    x:Class="WinSight.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="24" MaxWidth="800" HorizontalAlignment="Left">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Settings" Style="{ThemeResource TitleTextBlockStyle}"/>
                <TextBlock Text="Configure hotkeys, background indexing schedule, appearance and behavior."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- Hotkey Section -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Global Shortcut" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="Global keyboard shortcut to summon the Quick Search panel from anywhere in Windows."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="HotkeyBox"
                                 Text="{x:Bind ViewModel.Hotkey, Mode=TwoWay}"
                                 PlaceholderText="e.g. Control+Shift+Space"
                                 VerticalAlignment="Center"/>

                        <Button Grid.Column="1"
                                Content="Apply Hotkey"
                                Click="OnApplyHotkeyClick"
                                VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Conflict Warning Banner -->
                    <InfoBar IsOpen="{x:Bind ViewModel.HasHotkeyConflict, Mode=OneWay}"
                             Severity="Warning"
                             Title="Hotkey Registration Conflict"
                             Message="{x:Bind ViewModel.HotkeyConflictMessage, Mode=OneWay}"
                             IsClosable="False"/>
                </StackPanel>
            </Border>

            <!-- Background Indexing & Schedule Section -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Indexing &amp; Schedule" Style="{ThemeResource SubtitleTextBlockStyle}"/>

                    <!-- Background monitoring -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Background monitoring &amp; indexing" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Watch folders for changes and run debounce queue when idle."
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsOn="{x:Bind ViewModel.BackgroundIndexingEnabled, Mode=TwoWay}"/>
                    </Grid>

                    <!-- Index Hours Toggle -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Restrict Indexing to Specific Hours" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Limit heavy indexing to off-peak hours (times in minutes from midnight)."
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsOn="{x:Bind ViewModel.IndexHoursOn, Mode=TwoWay}"/>
                    </Grid>

                    <!-- Hours Inputs (in minutes since midnight) -->
                    <Grid ColumnSpacing="16" RowSpacing="8" Visibility="{x:Bind BoolToVisibility(ViewModel.IndexHoursOn), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Start (minutes from midnight, e.g. 60 = 01:00):" Style="{ThemeResource CaptionTextBlockStyle}"/>
                            <NumberBox Value="{x:Bind ViewModel.IndexHoursStart, Mode=TwoWay}"
                                       Minimum="0" Maximum="1439" SmallChange="15" SpinButtonPlacementMode="Inline"/>
                            <TextBlock Text="{x:Bind ViewModel.IndexHoursStartFormatted, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="End (minutes from midnight, e.g. 420 = 07:00):" Style="{ThemeResource CaptionTextBlockStyle}"/>
                            <NumberBox Value="{x:Bind ViewModel.IndexHoursEnd, Mode=TwoWay}"
                                       Minimum="0" Maximum="1439" SmallChange="15" SpinButtonPlacementMode="Inline"/>
                            <TextBlock Text="{x:Bind ViewModel.IndexHoursEndFormatted, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Processor Only -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Automatic indexing on AC power only" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Automatic indexing waits on battery or unknown power and pauses within 30 seconds after AC disconnects. Manual indexing remains available."
                                       TextWrapping="Wrap"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      AutomationProperties.AutomationId="AcOnlyIndexingToggle"
                                      AutomationProperties.Name="Automatic indexing on AC power only"
                                      IsOn="{x:Bind ViewModel.ProcessorOnly, Mode=TwoWay}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Appearance & Integration Section -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Appearance &amp; System Integration" Style="{ThemeResource SubtitleTextBlockStyle}"/>

                    <!-- Theme Selection -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Application Theme" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Choose system default, light or dark mode."
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  x:Name="ThemeComboBox"
                                  SelectionChanged="OnThemeSelectionChanged">
                            <ComboBoxItem Content="Default"/>
                            <ComboBoxItem Content="Light"/>
                            <ComboBoxItem Content="Dark"/>
                        </ComboBox>
                    </Grid>

                    <!-- Tray Click Action -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Tray Icon Left Click" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Action to perform when single-clicking the taskbar tray icon."
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  x:Name="TrayClickComboBox"
                                  SelectionChanged="OnTrayClickSelectionChanged">
                            <ComboBoxItem Content="Quick Search Panel"/>
                            <ComboBoxItem Content="Main Window"/>
                        </ComboBox>
                    </Grid>

                    <!-- Code Editor Choice -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Preferred Code Editor" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Editor used when opening code search results."
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  x:Name="CodeEditorComboBox"
                                  SelectionChanged="OnCodeEditorSelectionChanged">
                            <ComboBoxItem Content="Default System Editor"/>
                            <ComboBoxItem Content="Visual Studio Code (code)"/>
                        </ComboBox>
                    </Grid>

                    <!-- Open At Login -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Open at Windows Login" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Note: Registry changes are disabled during native migration preview."
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsOn="{x:Bind ViewModel.OpenAtLogin, Mode=TwoWay}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Hardware & Inference Acceleration Section -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="AI &amp; Hardware Acceleration" Style="{ThemeResource SubtitleTextBlockStyle}"/>

                    <!-- Accelerator Selection -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Acceleration device" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Choose the hardware used for embedding and model inference."
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  x:Name="AcceleratorComboBox"
                                  AutomationProperties.AutomationId="AcceleratorComboBox"
                                  AutomationProperties.Name="Acceleration device"
                                  SelectionChanged="OnAcceleratorSelectionChanged">
                            <ComboBoxItem Content="Automatic (discrete GPU first)" Tag="auto"/>
                            <ComboBoxItem Content="Discrete GPU" Tag="discrete-gpu"/>
                            <ComboBoxItem Content="NPU" Tag="npu"/>
                            <ComboBoxItem Content="GPU" Tag="gpu"/>
                            <ComboBoxItem Content="CPU" Tag="cpu"/>
                        </ComboBox>
                    </Grid>

                    <!-- Install Execution Providers Toggle -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Allow Windows ML to install and register execution providers" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Allow downloading or registering the applicable DirectML, NPU or GPU execution provider components."
                                       TextWrapping="Wrap"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    <TextBlock Text="NPU runs on a separate Windows ML host (ORT 1.27) because vendor NPU plugins are built against that runtime; every other choice uses the default host (ORT 1.31). Switching accelerators retires the previous index, since each runtime has its own embedding profile."
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                        <ToggleSwitch Grid.Column="1"
                                      AutomationProperties.AutomationId="InstallExecutionProvidersToggle"
                                      AutomationProperties.Name="Allow Windows ML to install and register execution providers"
                                      IsOn="{x:Bind ViewModel.InstallExecutionProviders, Mode=TwoWay}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Models -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="Models and devices" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="{x:Bind ViewModel.ModelsSummary, Mode=OneWay}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="ModelsSummary"/>
                    <Button Content="Refresh models" Click="OnRefreshModelsClick"
                            AutomationProperties.AutomationId="RefreshModelsButton"/>
                </StackPanel>
            </Border>

            <!-- MCP maintenance authorization -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="MCP maintenance requests" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="Clients cannot write the index themselves: an index_directory call lands here as a request. Drain hands accepted paths to the indexing queue; anything outside your configured folders is refused and the reason is recorded."
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Drain requests" Click="OnDrainMaintenanceClick"
                                IsEnabled="{x:Bind ViewModel.CanManageMaintenance, Mode=OneWay}"
                                AutomationProperties.AutomationId="DrainMaintenanceButton"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.MaintenanceSummary, Mode=OneWay}" TextWrapping="Wrap"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               AutomationProperties.AutomationId="MaintenanceSummary"/>
                </StackPanel>
            </Border>

            <!-- MCP client configuration -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="Connect an MCP client" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="Point at one client configuration file. Preview reports what would change; Apply backs the file up first and only adds the bridge path with --stdio. No token is written, and an existing different entry is refused."
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <RadioButton Content="stdio (recommended)" GroupName="ClientTransport"
                                     IsChecked="{x:Bind ViewModel.UseStdioTransport, Mode=TwoWay}"
                                     AutomationProperties.AutomationId="TransportStdioRadio"/>
                        <RadioButton Content="loopback HTTP" GroupName="ClientTransport"
                                     IsChecked="{x:Bind ViewModel.UseHttpTransport, Mode=TwoWay}"
                                     AutomationProperties.AutomationId="TransportHttpRadio"/>
                        <TextBox Header="Port" Width="110" Text="{x:Bind ViewModel.HttpPortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="HttpPortBox"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.ClientTransportDescription, Mode=OneWay}" TextWrapping="Wrap"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               AutomationProperties.AutomationId="ClientTransportDescription"/>
                    <TextBox Header="Client configuration file"
                             Text="{x:Bind ViewModel.ClientConfigPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="C:\path	o\client-config.json"
                             AutomationProperties.AutomationId="ClientConfigPathBox"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Preview" Click="OnPreviewClientConfigClick"
                                IsEnabled="{x:Bind ViewModel.CanConfigureClient, Mode=OneWay}"
                                AutomationProperties.AutomationId="PreviewClientConfigButton"/>
                        <Button Content="Apply" Click="OnApplyClientConfigClick"
                                IsEnabled="{x:Bind ViewModel.CanConfigureClient, Mode=OneWay}"
                                AutomationProperties.AutomationId="ApplyClientConfigButton"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.ClientConfigSummary, Mode=OneWay}" TextWrapping="Wrap"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               AutomationProperties.AutomationId="ClientConfigSummary"/>
                </StackPanel>
            </Border>

            <!-- NPU (isolated Windows ML host) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="NPU execution host" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="Separate process on Windows ML's own ONNX Runtime (1.27). It registers the vendor NPU libraries that already exist on this machine and reports each device it can see."
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{x:Bind ViewModel.NpuSummary, Mode=OneWay}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="NpuSummary"/>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.NpuDevices, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{x:Bind ViewModel.NpuQualification, Mode=OneWay}" TextWrapping="Wrap"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               AutomationProperties.AutomationId="NpuQualification"/>
                    <Button Content="Probe NPU host" Click="OnProbeNpuClick"
                            IsEnabled="{x:Bind ViewModel.CanProbeNpu, Mode=OneWay}"
                            AutomationProperties.AutomationId="ProbeNpuButton"/>
                </StackPanel>
            </Border>

            <!-- Foundry Local (isolated backend) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="Foundry Local backend" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="Isolated process that carries the Foundry Local runtime (ORT 1.31). Probing only discovers providers; nothing is downloaded."
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{x:Bind ViewModel.FoundrySummary, Mode=OneWay}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="FoundrySummary"/>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.FoundryProviders, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Probe Foundry Local" Click="OnProbeFoundryClick"
                                AutomationProperties.AutomationId="ProbeFoundryButton"/>
                        <Button Content="Install providers" Click="OnInstallFoundryProvidersClick"
                                IsEnabled="{x:Bind ViewModel.CanInstallFoundryProviders, Mode=OneWay}"
                                AutomationProperties.AutomationId="InstallFoundryProvidersButton"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="About" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <Grid ColumnSpacing="16" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Version" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}"
                                   AutomationProperties.AutomationId="AboutVersion" IsTextSelectionEnabled="True"/>
                        <TextBlock Grid.Row="1" Text="Project" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <HyperlinkButton Grid.Row="1" Grid.Column="1"
                                         Content="{x:Bind ViewModel.RepositoryUrl}"
                                         NavigateUri="{x:Bind ViewModel.RepositoryUrl}"
                                         AutomationProperties.AutomationId="AboutRepositoryLink"
                                         Padding="0"/>
                    </Grid>
                    <TextBlock Text="Local preview build: not a stable release. Legacy indexes are never migrated automatically."
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Save Button and Feedback -->
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Button Content="Save Settings"
                        Style="{ThemeResource AccentButtonStyle}"
                        Click="OnSaveSettingsClick"/>
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                           VerticalAlignment="Center"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
