<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="WinSight.App.Views.McpConsolePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="20" MaxWidth="{StaticResource WsPageMaxWidth}" HorizontalAlignment="Left">
            <Grid ColumnSpacing="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="MCP 客户端控制台 (SDK 2.0)" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center"/>
                    <TextBlock Text="将 WinSight 本地多模态知识库一键挂载至 Claude Desktop、Cursor、Windsurf、VS Code / Pi 等 AI 智能体。"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                        BorderBrush="{ThemeResource SystemFillColorSuccessBrush}" BorderThickness="1" CornerRadius="12" Padding="10,4">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{ThemeResource SystemFillColorSuccessBrush}"/>
                        <TextBlock Text="MCP 2.0 服务就绪" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- #1 Primary Card: Client-aware MCP JSON Configuration -->
            <Border Style="{StaticResource WsCardStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="智能体快速接入配置" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                            <TextBlock Text="{x:Bind ViewModel.ClientPathHint, Mode=OneWay}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       IsTextSelectionEnabled="True"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ComboBox x:Name="ClientSelector" SelectedIndex="0" SelectionChanged="OnClientChanged">
                                <ComboBoxItem Content="Claude Desktop" Tag="claude"/>
                                <ComboBoxItem Content="Cursor" Tag="cursor"/>
                                <ComboBoxItem Content="Windsurf" Tag="windsurf"/>
                                <ComboBoxItem Content="VS Code / Pi" Tag="vscode"/>
                            </ComboBox>
                            <Button Click="OnCopyConfigClick"
                                    Style="{ThemeResource AccentButtonStyle}" Padding="14,7" CornerRadius="6"
                                    AutomationProperties.AutomationId="McpConsoleCopyConfigButton">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                                    <TextBlock Text="一键复制配置" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TextBox Text="{x:Bind ViewModel.ConfigSnippet, Mode=OneWay}"
                             IsReadOnly="True" AcceptsReturn="True"
                             FontFamily="Cascadia Code, Consolas, Courier New"
                             FontSize="12" MinHeight="140"
                             TextWrapping="NoWrap"
                             AutomationProperties.AutomationId="McpConsoleConfigSnippetBox"/>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.CopyFeedback, Mode=OneWay}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="检查桥接器状态" CornerRadius="6" Click="OnProbeBridgeClick"/>
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.BridgeHealthStatus, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- #2 Card: Exposed MCP 2.0 Tools & Security Boundaries -->
            <Border Style="{StaticResource WsCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="已发布的 MCP 工具清单与安全边界" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Notes, Mode=OneWay}"
                                  AutomationProperties.AutomationId="McpConsoleNotes">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Style="{StaticResource WsSubCardStyle}" Padding="12,8" Margin="0,3">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE943;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind}" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- #3 Card: Bridge Request Queue & History -->
            <Border Style="{StaticResource WsCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="外部智能体维护请求队列" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               AutomationProperties.AutomationId="McpConsoleSummary"/>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Recent, Mode=OneWay}"
                                  AutomationProperties.AutomationId="McpConsoleRecent">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Style="{StaticResource WsSubCardStyle}" CornerRadius="6" Padding="10,6" Margin="0,2">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE756;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind}" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="刷新队列状态" CornerRadius="6" Click="OnRefreshClick"
                                AutomationProperties.AutomationId="McpConsoleRefreshButton"/>
                        <Button Content="执行等待请求" CornerRadius="6" Click="OnDrainClick"
                                IsEnabled="{x:Bind ViewModel.CanDrain, Mode=OneWay}"
                                AutomationProperties.AutomationId="McpConsoleDrainButton"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.ActionResult, Mode=OneWay}" TextWrapping="Wrap"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               AutomationProperties.AutomationId="McpConsoleActionResult"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
