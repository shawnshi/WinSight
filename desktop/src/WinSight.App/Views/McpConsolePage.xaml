<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="WinSight.App.Views.McpConsolePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ScrollViewer Padding="24">
        <StackPanel Spacing="16">
            <TextBlock Text="MCP console" Style="{ThemeResource TitleTextBlockStyle}"/>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="McpConsoleSummary"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Refresh" Click="OnRefreshClick"
                                AutomationProperties.AutomationId="McpConsoleRefreshButton"/>
                        <Button Content="Drain requests" Click="OnDrainClick"
                                IsEnabled="{x:Bind ViewModel.CanDrain, Mode=OneWay}"
                                AutomationProperties.AutomationId="McpConsoleDrainButton"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.ActionResult, Mode=OneWay}" TextWrapping="Wrap"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               AutomationProperties.AutomationId="McpConsoleActionResult"/>
                </StackPanel>
            </Border>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="Recent requests" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Recent, Mode=OneWay}"
                                  AutomationProperties.AutomationId="McpConsoleRecent">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="Transports" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Notes, Mode=OneWay}"
                                  AutomationProperties.AutomationId="McpConsoleNotes">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
