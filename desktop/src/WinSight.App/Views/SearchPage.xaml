<Page
    x:Class="WinSight.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WinSight.App.ViewModels"
    xmlns:views="using:WinSight.App.Views"
    mc:Ignorable="d"
    PreviewKeyDown="OnPagePreviewKeyDown"
    Unloaded="OnPageUnloaded">

    <Grid Padding="24,16,24,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox"
                     PlaceholderText="输入自然语言描述、精确单号，或以 code: 搜索代码..."
                     IsSpellCheckEnabled="False"
                     FontSize="14.5"
                     Padding="12,8"
                     CornerRadius="8"
                     AutomationProperties.Name="Search indexed local files"
                     Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PreviewKeyDown="OnSearchBoxKeyDown" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" x:Name="KindFilterCombo" SelectedIndex="0"
                      CornerRadius="8" Padding="12,7"
                      SelectionChanged="OnKindFilterChanged" VerticalAlignment="Center"
                      AutomationProperties.Name="File type filter">
                <ComboBoxItem Content="全部类型" Tag="all"/>
                <ComboBoxItem Content="文档" Tag="doc"/>
                <ComboBoxItem Content="PDF 文档" Tag="pdf"/>
                <ComboBoxItem Content="图片" Tag="image"/>
                <ComboBoxItem Content="屏幕截图" Tag="screenshot"/>
                <ComboBoxItem Content="音频" Tag="audio"/>
                <ComboBoxItem Content="视频" Tag="video"/>
                <ComboBoxItem Content="代码" Tag="code"/>
            </ComboBox>
        </Grid>
        <InfoBar x:Name="SearchNotice" Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
                 Severity="Informational" Message="{x:Bind ViewModel.NoticeText, Mode=OneWay}" IsClosable="False"/>

        <SplitView x:Name="PreviewHost" Grid.Row="2" PanePlacement="Right"
                   DisplayMode="Inline" IsPaneOpen="False"
                   PaneClosed="OnPreviewPaneClosed" SizeChanged="OnPreviewHostSizeChanged">
            <SplitView.Pane><views:SourcePreviewPane x:Name="SourcePreview" CloseRequested="OnPreviewCloseRequested"/></SplitView.Pane>
            <Grid>
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Width="48" Height="48" Canvas.ZIndex="10"/>

                <!-- Empty State Guidance -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="24" MaxWidth="560"
                            Visibility="{x:Bind GetEmptyStateVisibility(ViewModel.Hits.Count, ViewModel.IsLoading), Mode=OneWay}">
                    <FontIcon Glyph="&#xE721;" FontSize="40" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="探索你的本地全能记忆库" Style="{ThemeResource SubtitleTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="输入自然语言描述、精确单号或代码特征，WinSight 将在毫秒内穿透图文精准召回"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"/>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,8,0,0">
                        <StackPanel Spacing="8">
                            <TextBlock Text="💡 常用检索范式" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="• 文档描述：'医院数字化转型规划'、'包含 Q3 预算的工作表'" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="• 精准单号：'PRJ-2026-001'、'E1001 接口超时'" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="• 代码检索：'code: retry with backoff'、'code: RefreshToken'" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- DigUp Master-Detail Dual-Column Split (38% Master List : 62% Evidence Stage) -->
                <Border Visibility="{x:Bind GetResultsVisibility(ViewModel.Hits.Count), Mode=OneWay}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3.8*" MinWidth="260"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="6.2*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Compact Master List with Inline Pill Badges, Drag & Drop, and Context Menu -->
                        <ListView x:Name="ResultsListView"
                                  Grid.Column="0"
                                  Padding="6"
                                  CanDragItems="True"
                                  DragItemsStarting="OnResultsDragItemsStarting"
                                  ItemsSource="{x:Bind ViewModel.Hits, Mode=OneWay}"
                                  SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
                                  SelectionMode="Single" IsItemClickEnabled="True"
                                  ItemClick="OnResultItemClick" DoubleTapped="OnResultsDoubleTapped"
                                  SelectionChanged="OnResultsSelectionChanged"
                                  PreviewKeyDown="OnResultsPreviewKeyDown"
                                  AutomationProperties.Name="Search results. Space previews; Enter opens."
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:SearchItemViewModel">
                                    <Grid Padding="8,7" ColumnSpacing="10" Tag="{x:Bind}">
                                        <Grid.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="打开并定位到命中处" Click="OnContextOpenClick" Tag="{x:Bind}">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A7;"/></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="在资源管理器中显示" Click="OnContextRevealClick" Tag="{x:Bind}">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xED25;"/></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator/>
                                                <MenuFlyoutItem Text="复制命中段落文本" Click="OnContextCopyExcerptClick" Tag="{x:Bind}">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;"/></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="复制文件完整路径" Click="OnContextCopyPathClick" Tag="{x:Bind}">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71B;"/></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator/>
                                                <MenuFlyoutItem Text="页图与 OCR 详情校准" Click="OnContextPreviewClick" Tag="{x:Bind}">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;"/></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 38x38 Semantic Color-Coded Modality Badge -->
                                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="8"
                                                Background="{x:Bind IconBackgroundBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1" VerticalAlignment="Center">
                                            <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="17"
                                                      Foreground="{x:Bind IconForegroundBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- File Name + Inline Pill Badge + File Metadata Row + 1-Line Subtitle -->
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{x:Bind FileName}"
                                                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                           MaxLines="1" MaxWidth="220"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           ToolTipService.ToolTip="{x:Bind FileName}"/>
                                                <Border Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                                                        CornerRadius="8" Padding="6,1" VerticalAlignment="Center"
                                                        Visibility="{x:Bind HasLocationBadge}">
                                                    <TextBlock Text="{x:Bind CompactBadgeText}"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               Typography.NumeralAlignment="Tabular"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind ListItemMetadataLine}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       MaxLines="1"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind SubtitleText}"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       MaxLines="1"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Subtle Quick-Inspect Trigger (also used by UIA Harness) -->
                                        <Button Grid.Column="2"
                                                ToolTipService.ToolTip="页图与 OCR 详情 (Space)"
                                                AutomationProperties.Name="Preview source"
                                                Click="OnPreviewItemClick"
                                                Background="Transparent" BorderThickness="0"
                                                MinWidth="28" Height="28" Padding="4"
                                                VerticalAlignment="Center" Opacity="0.65"
                                                Tag="{x:Bind}">
                                            <FontIcon Glyph="&#xE8A5;" FontSize="13"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- 1px Hairline Divider -->
                        <Border Grid.Column="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                        <!-- Right Column: DigUp 4-Tier Evidence Stage -->
                        <ScrollViewer Grid.Column="2" Padding="28,22" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="18">
                                <!-- Tier 1: Hero Evidence Canvas (Paper Page Card, Image Preview, OR Monospace Code Surface) -->
                                <Grid>
                                    <!-- Image / Screenshot / Rendered Page Raster Preview Card -->
                                    <Border x:Name="HeroImageCard"
                                            Visibility="{x:Bind ViewModel.SelectedItem.IsImageVisibility, Mode=OneWay, FallbackValue=Collapsed}"
                                            Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="10"
                                            MinHeight="220" MaxHeight="320" Padding="8">
                                        <Grid>
                                            <Image x:Name="HeroPreviewImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1" CornerRadius="10" Padding="10,3"
                                                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"
                                                    Visibility="{x:Bind ViewModel.SelectedItem.HasLocationBadge, Mode=OneWay, FallbackValue=Collapsed}">
                                                <TextBlock Text="{x:Bind ViewModel.SelectedItem.CompactBadgeText, Mode=OneWay, FallbackValue=''}"
                                                           FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Document / PDF Paper Page Card (with simulated page header & bottom-left p. X pill) -->
                                    <Border x:Name="HeroDocumentCard"
                                            Visibility="{x:Bind ViewModel.SelectedItem.IsDocumentVisibility, Mode=OneWay, FallbackValue=Visible}"
                                            Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="10"
                                            MinHeight="220" MaxHeight="320" Padding="24,18">
                                        <Grid RowSpacing="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <!-- Simulated Document Header Bar -->
                                            <Border Grid.Row="0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,8">
                                                <Grid>
                                                    <TextBlock Text="{x:Bind ViewModel.SelectedItem.FileName, Mode=OneWay, FallbackValue=''}"
                                                               FontSize="11.5" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                               MaxLines="1" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock HorizontalAlignment="Right"
                                                               Text="{x:Bind ViewModel.SelectedItem.LocationDisplay, Mode=OneWay, FallbackValue=''}"
                                                               FontSize="11.5" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                </Grid>
                                            </Border>
                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                                <TextBlock x:Name="CanvasExcerptBlock"
                                                           Text="{x:Bind ViewModel.SelectedItem.CanvasExcerptText, Mode=OneWay, FallbackValue=''}"
                                                           TextWrapping="Wrap"
                                                           IsTextSelectionEnabled="True"
                                                           FontSize="13.5" LineHeight="23"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                           Margin="0,0,0,28"/>
                                            </ScrollViewer>
                                            <!-- Floating Bottom-Left Page Pill (p. 4) -->
                                            <Border Grid.Row="1" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1" CornerRadius="10" Padding="10,3"
                                                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                    Visibility="{x:Bind ViewModel.SelectedItem.HasLocationBadge, Mode=OneWay, FallbackValue=Collapsed}">
                                                <TextBlock Text="{x:Bind ViewModel.SelectedItem.CompactBadgeText, Mode=OneWay, FallbackValue=''}"
                                                           FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Code Monospace Canvas -->
                                    <Border x:Name="HeroCodeCard"
                                            Visibility="{x:Bind ViewModel.SelectedItem.IsCodeVisibility, Mode=OneWay, FallbackValue=Collapsed}"
                                            Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="10"
                                            MinHeight="210" MaxHeight="310" Padding="20,16">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                            <TextBlock x:Name="CodeExcerptBlock"
                                                       Text="{x:Bind ViewModel.SelectedItem.CanvasExcerptText, Mode=OneWay, FallbackValue=''}"
                                                       FontFamily="Cascadia Code, Consolas, Courier New"
                                                       FontSize="12.5" LineHeight="20"
                                                       TextWrapping="NoWrap"
                                                       IsTextSelectionEnabled="True"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>

                                <!-- Tier 2: 3-Line Metadata Block -->
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedItem.FileName, Mode=OneWay, FallbackValue=''}"
                                               FontSize="18" FontWeight="SemiBold"
                                               TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedItem.FriendlyDirectoryPath, Mode=OneWay, FallbackValue=''}"
                                               FontSize="13"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind ViewModel.SelectedItem.DirectoryPath, Mode=OneWay, FallbackValue=''}"/>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedItem.FileMetadataLine, Mode=OneWay, FallbackValue=''}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                </StackPanel>

                                <!-- Tier 3: Explainable Match Callout (Amber Magnifying Glass + Context) -->
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon Glyph="&#xE721;" FontSize="13" Foreground="#F2A900" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind ViewModel.SelectedItem.MatchRationale, Mode=OneWay, FallbackValue=''}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="MatchCalloutExcerptBlock"
                                               Text="{x:Bind ViewModel.SelectedItem.SubtitleText, Mode=OneWay, FallbackValue=''}"
                                               FontSize="12.5" MaxLines="2" TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Visibility="{x:Bind ViewModel.SelectedItem.ExcerptVisibility, Mode=OneWay, FallbackValue=Collapsed}"/>
                                </StackPanel>

                                <!-- Tier 4: Dual Pill Action Buttons -->
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,0">
                                    <Button Style="{ThemeResource AccentButtonStyle}"
                                            Click="OnOpenSelectedClick"
                                            CornerRadius="6" Padding="16,7">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedItem.PrimaryOpenLabel, Mode=OneWay, FallbackValue='打开文件'}"
                                                   FontWeight="SemiBold"/>
                                    </Button>
                                    <Button Click="OnRevealSelectedClick"
                                            CornerRadius="6" Padding="14,7">
                                        <TextBlock Text="在资源管理器中显示"/>
                                    </Button>
                                    <Button Click="OnPreviewSelectedClick"
                                            CornerRadius="6" Padding="12,7"
                                            ToolTipService.ToolTip="打开高清页面光栅图与 OCR 坐标框视图 (Space)">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8A5;" FontSize="13"/>
                                            <TextBlock Text="页图校准"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OnCopySelectedClick"
                                            CornerRadius="6" Padding="10,7"
                                            ToolTipService.ToolTip="复制文件完整路径 (Ctrl+C)">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="13"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </SplitView>

        <!-- DigUp-style Footer Bar (Left: Results Count, Right: Inline Keycap Shortcuts) -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="1"
                       Text="↵ 打开定位    Ctrl+↵ 在资源管理器中显示    Space 页图预览    Ctrl+C 复制路径"
                       Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Page>
