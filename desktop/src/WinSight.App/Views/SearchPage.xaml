<Page
    x:Class="WinSight.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WinSight.App.ViewModels"
    xmlns:views="using:WinSight.App.Views"
    mc:Ignorable="d"
    PreviewKeyDown="OnPagePreviewKeyDown"
    Unloaded="OnPageUnloaded">

    <Grid Padding="24,16,24,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox"
                     PlaceholderText="Search files, documents, media and code..."
                     AutomationProperties.Name="Search indexed local files"
                     Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PreviewKeyDown="OnSearchBoxKeyDown" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" x:Name="KindFilterCombo" SelectedIndex="0"
                      SelectionChanged="OnKindFilterChanged" VerticalAlignment="Center"
                      AutomationProperties.Name="File type filter">
                <ComboBoxItem Content="All Types" Tag="all"/>
                <ComboBoxItem Content="Documents" Tag="doc"/>
                <ComboBoxItem Content="PDF" Tag="pdf"/>
                <ComboBoxItem Content="Images" Tag="image"/>
                <ComboBoxItem Content="Screenshots" Tag="screenshot"/>
                <ComboBoxItem Content="Audio" Tag="audio"/>
                <ComboBoxItem Content="Video" Tag="video"/>
                <ComboBoxItem Content="Code" Tag="code"/>
            </ComboBox>
        </Grid>
        <InfoBar x:Name="SearchNotice" Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
                 Severity="Informational" Message="{x:Bind ViewModel.NoticeText, Mode=OneWay}" IsClosable="False"/>

        <SplitView x:Name="PreviewHost" Grid.Row="2" PanePlacement="Right"
                   DisplayMode="Inline" IsPaneOpen="False"
                   PaneClosed="OnPreviewPaneClosed" SizeChanged="OnPreviewHostSizeChanged">
            <SplitView.Pane><views:SourcePreviewPane x:Name="SourcePreview" CloseRequested="OnPreviewCloseRequested"/></SplitView.Pane>
            <Grid>
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Width="48" Height="48"/>
                <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center" Spacing="8" Margin="12"
                            Visibility="{x:Bind GetEmptyStateVisibility(ViewModel.Hits.Count, ViewModel.IsLoading), Mode=OneWay}">
                    <FontIcon Glyph="&#xE721;" FontSize="36" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="No search results" Style="{ThemeResource SubtitleTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="Type a query above to search indexed local files"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
                <ListView x:Name="ResultsListView"
                          ItemsSource="{x:Bind ViewModel.Hits, Mode=OneWay}"
                          SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
                          SelectionMode="Single" IsItemClickEnabled="True"
                          ItemClick="OnResultItemClick" PreviewKeyDown="OnResultsPreviewKeyDown"
                          AutomationProperties.Name="Search results. Space previews; Enter opens."
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SearchItemViewModel">
                            <Grid Padding="12,10" ColumnSpacing="12" RowSpacing="6"
                                  BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="24" VerticalAlignment="Center"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind FileName}" Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                   MaxLines="1" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind FileName}"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind LocationDisplay}" MaxWidth="96" MaxLines="1"
                                                   TextTrimming="CharacterEllipsis" Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="{x:Bind DirectoryPath}" Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind Excerpt}" Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" MaxLines="2" TextTrimming="CharacterEllipsis"
                                               Visibility="{x:Bind ExcerptVisibility}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                    <TextBlock Text="{x:Bind ScoreDisplay}" Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button ToolTipService.ToolTip="Preview source (Space)" AutomationProperties.Name="Preview source"
                                            Click="OnPreviewItemClick" MinWidth="32" Padding="6" Tag="{x:Bind}">
                                        <FontIcon Glyph="&#xE8A5;" FontSize="14"/>
                                    </Button>
                                    <Button ToolTipService.ToolTip="Open File" AutomationProperties.Name="Open file"
                                            Click="OnOpenItemClick" MinWidth="32" Padding="6" Tag="{x:Bind}">
                                        <FontIcon Glyph="&#xE8A7;" FontSize="14"/>
                                    </Button>
                                    <Button ToolTipService.ToolTip="Show in Explorer" AutomationProperties.Name="Show in Explorer"
                                            Click="OnRevealItemClick" MinWidth="32" Padding="6" Tag="{x:Bind}">
                                        <FontIcon Glyph="&#xED25;" FontSize="14"/>
                                    </Button>
                                    <Button ToolTipService.ToolTip="Copy File Path" AutomationProperties.Name="Copy file path"
                                            Click="OnCopyItemClick" MinWidth="32" Padding="6" Tag="{x:Bind}">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </SplitView>
        <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                   Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap"/>
    </Grid>
</Page>
