<Page
    x:Class="WinSight.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WinSight.App.ViewModels"
    xmlns:views="using:WinSight.App.Views"
    mc:Ignorable="d"
    PreviewKeyDown="OnPagePreviewKeyDown"
    Loaded="OnPageLoaded"
    SizeChanged="OnPageSizeChanged"
    Unloaded="OnPageUnloaded">

    <Page.Resources>
        <XamlUICommand x:Key="OpenCommand" Label="打开并定位到命中处" Description="打开文件并跳到命中位置" ExecuteRequested="OnOpenCommand">
            <XamlUICommand.IconSource><FontIconSource Glyph="&#xE8A7;"/></XamlUICommand.IconSource>
        </XamlUICommand>
        <XamlUICommand x:Key="RevealCommand" Label="在资源管理器中显示" Description="在资源管理器中选中该文件 (Ctrl+Enter)" ExecuteRequested="OnRevealCommand">
            <XamlUICommand.IconSource><FontIconSource Glyph="&#xED25;"/></XamlUICommand.IconSource>
        </XamlUICommand>
        <XamlUICommand x:Key="PreviewCommand" Label="页面预览与 OCR" Description="打开页面大图与 OCR 文字行 (空格键)" ExecuteRequested="OnPreviewCommand">
            <XamlUICommand.IconSource><FontIconSource Glyph="&#xE8A5;"/></XamlUICommand.IconSource>
        </XamlUICommand>
        <XamlUICommand x:Key="CopyPathCommand" Label="复制文件路径" Description="复制文件完整路径 (Ctrl+C)" ExecuteRequested="OnCopyPathCommand">
            <XamlUICommand.IconSource><FontIconSource Glyph="&#xE8C8;"/></XamlUICommand.IconSource>
        </XamlUICommand>
        <XamlUICommand x:Key="CopyExcerptCommand" Label="复制命中文本" Description="复制命中段落的文本" ExecuteRequested="OnCopyExcerptCommand">
            <XamlUICommand.IconSource><FontIconSource Glyph="&#xE8C8;"/></XamlUICommand.IconSource>
        </XamlUICommand>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="OnFocusSearchAccelerator"/>
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFocusSearchAccelerator"/>
    </Page.KeyboardAccelerators>

    <Grid Padding="24,12,24,8" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <AutoSuggestBox x:Name="SearchBox"
                            PlaceholderText="输入自然语言描述、精确单号，或以 code: 搜索代码；type:pdf 可限定类型"
                            QueryIcon="Find"
                            UpdateTextOnSelect="True"
                            CornerRadius="8"
                            AutomationProperties.Name="搜索已索引的本地文件"
                            Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextChanged="OnSearchTextChanged"
                            SuggestionChosen="OnSuggestionChosen"
                            QuerySubmitted="OnQuerySubmitted"
                            GotFocus="OnSearchBoxGotFocus"
                            PreviewKeyDown="OnSearchBoxKeyDown"/>
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Auto" VerticalScrollMode="Disabled">
                    <SelectorBar x:Name="KindSelector" SelectionChanged="OnKindSelectorChanged"
                                 AutomationProperties.Name="文件类型筛选">
                        <SelectorBarItem Text="全部" Tag="all" IsSelected="True"/>
                        <SelectorBarItem Text="文档" Tag="doc"/>
                        <SelectorBarItem Text="PDF" Tag="pdf"/>
                        <SelectorBarItem Text="图片" Tag="image"/>
                        <SelectorBarItem Text="截图" Tag="screenshot"/>
                        <SelectorBarItem Text="音频" Tag="audio"/>
                        <SelectorBarItem Text="视频" Tag="video"/>
                        <SelectorBarItem Text="代码" Tag="code"/>
                    </SelectorBar>
                </ScrollViewer>
                <ComboBox x:Name="ModeComboBox" Grid.Column="1" VerticalAlignment="Center"
                          SelectedIndex="0" SelectionChanged="OnModeSelectionChanged"
                          ToolTipService.ToolTip="切换检索模式：混合（关键词+语义）、纯语义向量或纯关键词"
                          AutomationProperties.Name="检索模式">
                    <ComboBoxItem Content="混合检索" Tag="hybrid"/>
                    <ComboBoxItem Content="仅语义" Tag="semantic"/>
                    <ComboBoxItem Content="仅关键词" Tag="keyword"/>
                </ComboBox>
            </Grid>
        </StackPanel>
        <InfoBar x:Name="SearchNotice" Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
                 Severity="Informational" Message="{x:Bind ViewModel.NoticeText, Mode=OneWay}" IsClosable="False"/>

        <SplitView x:Name="PreviewHost" Grid.Row="2" PanePlacement="Right"
                   DisplayMode="Inline" IsPaneOpen="False"
                   PaneClosed="OnPreviewPaneClosed" SizeChanged="OnPreviewHostSizeChanged">
            <SplitView.Pane><views:SourcePreviewPane x:Name="SourcePreview" CloseRequested="OnPreviewCloseRequested"/></SplitView.Pane>
            <Grid>
                <!-- Busy indicator: a thin bar over the list top edge so rows stay readable while the semantic pass merges in -->
                <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" Canvas.ZIndex="10"
                             Visibility="{x:Bind VisibleIf(ViewModel.IsLoading), Mode=OneWay}"
                             AutomationProperties.Name="正在搜索"/>

                <!-- Idle: nothing typed yet -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="24" MaxWidth="560"
                            Visibility="{x:Bind VisibleIf(ViewModel.IsIdle), Mode=OneWay}">
                    <FontIcon Glyph="&#xE721;" FontSize="40" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="搜索你的本地文件" Style="{ThemeResource SubtitleTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="用自然语言描述内容，或输入精确单号、代码特征。按 Ctrl+K 可随时回到搜索框。"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"/>
                    <TextBlock Text="试试这些检索方式" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                    <StackPanel x:Name="ExampleChips" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Button Content="医院数字化转型规划" Tag="医院数字化转型规划" Click="OnExampleChipClick" CornerRadius="16" Padding="14,5"/>
                        <Button Content="PRJ-2026-001" Tag="PRJ-2026-001" Click="OnExampleChipClick" CornerRadius="16" Padding="14,5"/>
                        <Button Content="code: RefreshToken" Tag="code: RefreshToken" Click="OnExampleChipClick" CornerRadius="16" Padding="14,5"/>
                    </StackPanel>
                    <StackPanel Spacing="6" Margin="0,6,0,0" HorizontalAlignment="Center">
                        <TextBlock Text="快捷过滤语法（点击插入）" Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <Button Content="folder1:" Tag="folder1:" Click="OnSyntaxChipClick" CornerRadius="12" Padding="10,3" FontSize="12"/>
                            <Button Content="type:pdf" Tag="type:pdf " Click="OnSyntaxChipClick" CornerRadius="12" Padding="10,3" FontSize="12"/>
                            <Button Content="sheet:" Tag="sheet:" Click="OnSyntaxChipClick" CornerRadius="12" Padding="10,3" FontSize="12"/>
                            <Button Content="amount:" Tag="amount:" Click="OnSyntaxChipClick" CornerRadius="12" Padding="10,3" FontSize="12"/>
                            <Button Content="date:" Tag="date:" Click="OnSyntaxChipClick" CornerRadius="12" Padding="10,3" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Spacing="4" Margin="0,12,0,0"
                                Visibility="{x:Bind VisibleIfAny(ViewModel.History.Items.Count), Mode=OneWay}">
                        <Grid>
                            <TextBlock Text="最近搜索" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                            <HyperlinkButton Content="清除" HorizontalAlignment="Right" Click="OnClearHistoryClick"
                                             AutomationProperties.Name="清除搜索历史"/>
                        </Grid>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.History.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <HyperlinkButton Content="{x:Bind}" Tag="{x:Bind}" Click="OnExampleChipClick" Padding="2,3"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <!-- No results for a non-empty query -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Margin="24" MaxWidth="520"
                            Visibility="{x:Bind VisibleIf(ViewModel.IsNoResults), Mode=OneWay}">
                    <FontIcon Glyph="&#xE721;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{x:Bind NoResultsTitle(ViewModel.Query), Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="换一个说法、减少限定词，或把类型筛选切回“全部”。如果文件刚刚新增，请等待索引完成。"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"/>
                    <Button Content="清除筛选并重试" HorizontalAlignment="Center" Click="OnClearFilterClick" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Search failed -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Margin="24" MaxWidth="520"
                            Visibility="{x:Bind VisibleIf(ViewModel.IsError), Mode=OneWay}">
                    <FontIcon Glyph="&#xE783;" FontSize="36" Foreground="{ThemeResource SystemFillColorCriticalBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="搜索没有完成" Style="{ThemeResource SubtitleTextBlockStyle}" TextAlignment="Center"/>
                    <TextBlock Text="{x:Bind ViewModel.NoticeText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextAlignment="Center" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                    <Button Content="重试" HorizontalAlignment="Center" Click="OnRetrySearchClick" Style="{ThemeResource AccentButtonStyle}" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- DigUp Master-Detail Dual-Column Split (38% Master List : 62% Evidence Stage) -->
                <Border Visibility="{x:Bind GetResultsVisibility(ViewModel.Hits.Count), Mode=OneWay}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Translation="0,0,12"
                        x:Name="ResultsCard" SizeChanged="OnResultsCardSizeChanged">
                    <Border.Shadow><ThemeShadow/></Border.Shadow>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ListColumn" Width="3.8*" MinWidth="260"/>
                            <ColumnDefinition x:Name="SplitterColumn" Width="9"/>
                            <ColumnDefinition x:Name="StageColumn" Width="6.2*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Compact Master List with Inline Pill Badges, Drag & Drop, and Context Menu -->
                        <ListView x:Name="ResultsListView"
                                  Grid.Column="0"
                                  Padding="6"
                                  CanDragItems="True"
                                  DragItemsStarting="OnResultsDragItemsStarting"
                                  ItemsSource="{x:Bind ViewModel.Hits, Mode=OneWay}"
                                  SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
                                  SelectionMode="Single" IsItemClickEnabled="True"
                                  ItemClick="OnResultItemClick" DoubleTapped="OnResultsDoubleTapped"
                                  SelectionChanged="OnResultsSelectionChanged"

                                  ContainerContentChanging="OnResultsContainerContentChanging"
                                  PreviewKeyDown="OnResultsPreviewKeyDown"
                                  AutomationProperties.Name="搜索结果列表。空格键打开页面预览，回车键打开文件。"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.KeyboardAccelerators>
                                <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="OnCopyAccelerator"/>
                                <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="OnRevealAccelerator"/>
                            </ListView.KeyboardAccelerators>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:SearchItemViewModel">
                                    <Grid Padding="8,8" ColumnSpacing="10" Tag="{x:Bind}" AutomationProperties.Name="{x:Bind ListAutomationName}">
                                        <Grid.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Command="{StaticResource OpenCommand}" CommandParameter="{x:Bind}"/>
                                                <MenuFlyoutItem Command="{StaticResource RevealCommand}" CommandParameter="{x:Bind}"/>
                                                <MenuFlyoutSeparator/>
                                                <MenuFlyoutItem Command="{StaticResource CopyExcerptCommand}" CommandParameter="{x:Bind}"/>
                                                <MenuFlyoutItem Command="{StaticResource CopyPathCommand}" CommandParameter="{x:Bind}"/>
                                                <MenuFlyoutSeparator/>
                                                <MenuFlyoutItem Command="{StaticResource PreviewCommand}" CommandParameter="{x:Bind}"/>
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Thumbnail (shell preview when available) over the semantic type badge -->
                                        <Grid Grid.Column="0" Width="48" Height="48" VerticalAlignment="Center" Visibility="{x:Bind PrimaryRowVisibility}">
                                            <Border CornerRadius="8"
                                                    Background="{x:Bind IconBackgroundBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    Visibility="{x:Bind BadgeVisibility, Mode=OneWay}">
                                                <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="18"
                                                          Foreground="{x:Bind IconForegroundBrush}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                    Visibility="{x:Bind ThumbnailVisibility, Mode=OneWay}">
                                                <Image Source="{x:Bind ThumbnailSource, Mode=OneWay}" Stretch="Uniform" Margin="2"/>
                                            </Border>
                                        </Grid>

                                        <!-- Two-line title, folder context, compact metadata, one-line match -->
                                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="{x:Bind TextIndent}">
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind RowTitle}"
                                                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                           MaxLines="2" TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           ToolTipService.ToolTip="{x:Bind Path}"/>
                                                <Border Grid.Column="1" Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                                                        CornerRadius="8" Padding="6,1" VerticalAlignment="Top" Margin="0,2,0,0"
                                                        Visibility="{x:Bind HasLocationBadge}">
                                                    <TextBlock Text="{x:Bind CompactBadgeText}"
                                                               Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               Typography.NumeralAlignment="Tabular"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{x:Bind ListMetaCompact}"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       Visibility="{x:Bind PrimaryRowVisibility}"
                                                       MaxLines="1" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind SubtitleText}"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       MaxLines="1" TextTrimming="CharacterEllipsis"/>
                                            <HyperlinkButton Tag="{x:Bind}" Click="OnGroupToggleClick" Padding="0,2" MinHeight="0"
                                                             Visibility="{x:Bind GroupToggleVisibility}"
                                                             AutomationProperties.Name="{x:Bind GroupToggleText, Mode=OneWay}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="{x:Bind GroupToggleGlyph, Mode=OneWay}" FontSize="10"/>
                                                    <TextBlock Text="{x:Bind GroupToggleText, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}"/>
                                                </StackPanel>
                                            </HyperlinkButton>
                                        </StackPanel>

                                        <!-- Subtle Quick-Inspect Trigger (also used by UIA Harness) -->
                                        <Button Grid.Column="2"
                                                ToolTipService.ToolTip="交互大图与 OCR 详情 (Space)"
                                                AutomationProperties.Name="Preview source"
                                                Click="OnPreviewItemClick"
                                                Background="Transparent" BorderThickness="0"
                                                MinWidth="26" Height="26" Padding="3"
                                                VerticalAlignment="Center" Opacity="0.45"
                                                Tag="{x:Bind}">
                                            <FontIcon Glyph="&#xE8A5;" FontSize="12"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Draggable divider: wide hit area, 1px hairline -->
                        <views:SplitterHandle x:Name="ListSplitter" Grid.Column="1"
                                              Dragged="OnSplitterDragged" DragCompleted="OnSplitterDragCompleted" ResetRequested="OnSplitterReset">
                            <Rectangle Width="1" HorizontalAlignment="Center" IsHitTestVisible="False"
                                       Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                        </views:SplitterHandle>

                        <!-- Right Column: DigUp 4-Tier Evidence Stage -->
                        <ScrollViewer x:Name="DetailScroll" Grid.Column="2" Padding="28,22" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="18">
                                <HyperlinkButton x:Name="BackToListButton" Visibility="Collapsed" Click="OnBackToListClick" Padding="0,2"
                                                 AutomationProperties.Name="返回结果列表">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE76B;" FontSize="12"/>
                                        <TextBlock Text="返回结果列表"/>
                                    </StackPanel>
                                </HyperlinkButton>
                                <!-- Tier 1: Hero Evidence Canvas (Paper Page Card, Image Preview, OR Monospace Code Surface) -->
                                <Grid x:Name="HeroStage">
                                    <!-- Image / Screenshot / Rendered Page Raster Preview Card -->
                                    <Border x:Name="HeroImageCard"
                                            Visibility="{x:Bind ViewModel.SelectedItem.IsImageVisibility, Mode=OneWay, FallbackValue=Collapsed}"
                                            Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="10"
                                            MinHeight="240" MaxHeight="520" Padding="8">
                                        <Grid>
                                            <Image x:Name="HeroPreviewImage" Stretch="Uniform"
                                                   MinHeight="220" MaxHeight="480"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1" CornerRadius="10" Padding="10,3"
                                                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"
                                                    Visibility="{x:Bind ViewModel.SelectedItem.HasLocationBadge, Mode=OneWay, FallbackValue=Collapsed}">
                                                <TextBlock Text="{x:Bind ViewModel.SelectedItem.CompactBadgeText, Mode=OneWay, FallbackValue=''}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Document / PDF Paper Page Card (with simulated page header & bottom-left p. X pill) -->
                                    <Border x:Name="HeroDocumentCard"
                                            Visibility="{x:Bind ViewModel.SelectedItem.IsDocumentVisibility, Mode=OneWay, FallbackValue=Visible}"
                                            Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="10"
                                            MinHeight="220" MaxHeight="340" Padding="20,16">
                                        <Grid RowSpacing="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <!-- Simulated Document Header Bar with In-Place Page Stepper -->
                                            <Border Grid.Row="0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,8">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.SelectedItem.FileName, Mode=OneWay, FallbackValue=''}"
                                                               Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                               MaxLines="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <StackPanel x:Name="HeroPageStepper" Grid.Column="1" Orientation="Horizontal" Spacing="4" Visibility="Collapsed" VerticalAlignment="Center">
                                                        <Button x:Name="HeroPrevPageBtn" Click="OnHeroPrevPageClick" Padding="5,2" MinWidth="24" MinHeight="22" CornerRadius="4" ToolTipService.ToolTip="上一页">
                                                            <FontIcon Glyph="&#xE76B;" FontSize="10"/>
                                                        </Button>
                                                        <TextBlock x:Name="HeroPageText" Text="1 / 1" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" Margin="2,0"/>
                                                        <Button x:Name="HeroNextPageBtn" Click="OnHeroNextPageClick" Padding="5,2" MinWidth="24" MinHeight="22" CornerRadius="4" ToolTipService.ToolTip="下一页">
                                                            <FontIcon Glyph="&#xE76C;" FontSize="10"/>
                                                        </Button>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{x:Bind ViewModel.SelectedItem.LocationDisplay, Mode=OneWay, FallbackValue=''}"
                                                               Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <Grid Grid.Row="1">
                                                <ScrollViewer x:Name="DocumentExcerptScroll" MaxHeight="280" VerticalScrollBarVisibility="Auto">
                                                    <TextBlock x:Name="CanvasExcerptBlock"
                                                               Text="{x:Bind ViewModel.SelectedItem.CanvasExcerptText, Mode=OneWay, FallbackValue=''}"
                                                               TextWrapping="Wrap"
                                                               IsTextSelectionEnabled="True"
                                                               Style="{ThemeResource BodyTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                               Margin="0,0,0,28"/>
                                                </ScrollViewer>
                                                <Border x:Name="DocumentRasterBorder" CornerRadius="6"
                                                        Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                                        Visibility="Collapsed">
                                                    <ScrollViewer x:Name="DocumentRasterScroll"
                                                                  MaxHeight="640"
                                                                  VerticalScrollBarVisibility="Auto"
                                                                  HorizontalScrollBarVisibility="Auto"
                                                                  ZoomMode="Enabled"
                                                                  MinZoomFactor="0.5"
                                                                  MaxZoomFactor="3.0"
                                                                  SizeChanged="OnDocumentRasterScrollSizeChanged">
                                                        <Image x:Name="DocumentRasterImage"
                                                               Stretch="Uniform"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Top"
                                                               Tapped="OnDocumentRasterImageTapped"
                                                               ToolTipService.ToolTip="点击打开大图与 OCR 标定 (Space)；支持 Ctrl+滚轮缩放"/>
                                                    </ScrollViewer>
                                                </Border>
                                            </Grid>
                                            <!-- Floating Bottom-Left Page Pill (p. 4) -->
                                            <Border Grid.Row="1" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1" CornerRadius="10" Padding="10,3"
                                                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                    Visibility="{x:Bind ViewModel.SelectedItem.HasLocationBadge, Mode=OneWay, FallbackValue=Collapsed}">
                                                <TextBlock Text="{x:Bind ViewModel.SelectedItem.CompactBadgeText, Mode=OneWay, FallbackValue=''}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </Border>
                                            <!-- Subtle Bottom-Right Rendering Pill -->
                                            <Border x:Name="PreviewLoadingPill" Grid.Row="1"
                                                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1" CornerRadius="10" Padding="10,4"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Visibility="Collapsed">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <ProgressRing IsActive="True" Width="12" Height="12"/>
                                                    <TextBlock Text="正在渲染高清预览…" Style="{ThemeResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Code Monospace Canvas -->
                                    <Border x:Name="HeroCodeCard"
                                            Visibility="{x:Bind ViewModel.SelectedItem.IsCodeVisibility, Mode=OneWay, FallbackValue=Collapsed}"
                                            Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="10"
                                            MinHeight="210" MaxHeight="310" Padding="20,16">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                            <TextBlock x:Name="CodeExcerptBlock"
                                                       Text="{x:Bind ViewModel.SelectedItem.CanvasExcerptText, Mode=OneWay, FallbackValue=''}"
                                                       FontFamily="Cascadia Code, Consolas, Courier New"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       TextWrapping="NoWrap"
                                                       IsTextSelectionEnabled="True"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>

                                <!-- Tier 2: 3-Line Metadata Block -->
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedItem.FileName, Mode=OneWay, FallbackValue=''}"
                                               Style="{ThemeResource SubtitleTextBlockStyle}"
                                               TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedItem.FriendlyDirectoryPath, Mode=OneWay, FallbackValue=''}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind ViewModel.SelectedItem.DirectoryPath, Mode=OneWay, FallbackValue=''}"/>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedItem.FileMetadataLine, Mode=OneWay, FallbackValue=''}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                </StackPanel>

                                <!-- Tier 3: Explainable Match Callout (Amber Magnifying Glass + Context) -->
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon Glyph="&#xE721;" FontSize="13" Foreground="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind ViewModel.SelectedItem.MatchRationale, Mode=OneWay, FallbackValue=''}"
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Tier 4: primary action + shared commands -->
                                <Grid ColumnSpacing="8" Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{ThemeResource AccentButtonStyle}"
                                            Click="OnOpenSelectedClick"
                                            CornerRadius="6" Padding="16,7" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedItem.PrimaryOpenLabel, Mode=OneWay, FallbackValue='打开文件'}"
                                                   FontWeight="SemiBold"/>
                                    </Button>
                                    <CommandBar x:Name="ActionBar" Grid.Column="1" Background="Transparent" DefaultLabelPosition="Right"
                                                HorizontalAlignment="Left" IsOpen="False"
                                                AutomationProperties.Name="文件操作">
                                        <AppBarButton Command="{StaticResource PreviewCommand}" CommandParameter="{x:Bind ViewModel.SelectedItem, Mode=OneWay}"/>
                                        <AppBarButton Command="{StaticResource RevealCommand}" CommandParameter="{x:Bind ViewModel.SelectedItem, Mode=OneWay}"/>
                                        <AppBarButton Command="{StaticResource CopyPathCommand}" CommandParameter="{x:Bind ViewModel.SelectedItem, Mode=OneWay}"/>
                                        <CommandBar.SecondaryCommands>
                                            <AppBarButton Command="{StaticResource CopyExcerptCommand}" CommandParameter="{x:Bind ViewModel.SelectedItem, Mode=OneWay}"/>
                                        </CommandBar.SecondaryCommands>
                                    </CommandBar>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </SplitView>

        <!-- DigUp-style Footer Bar (Left: Results Count, Right: Inline Keycap Shortcuts) -->
        <Grid Grid.Row="3" Margin="0,2,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusLine" Grid.Column="0" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            <ScrollViewer x:Name="FooterHintsHost" Grid.Column="1" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled" IsTabStop="False">
            <StackPanel x:Name="FooterHints" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Border Style="{StaticResource WsKeyCapBorder}"><TextBlock Style="{StaticResource WsKeyCapText}" Text="↵"/></Border>
                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="2,0,0,0" Text="打开并定位"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Border Style="{StaticResource WsKeyCapBorder}"><TextBlock Style="{StaticResource WsKeyCapText}" Text="Ctrl"/></Border>
                    <Border Style="{StaticResource WsKeyCapBorder}"><TextBlock Style="{StaticResource WsKeyCapText}" Text="↵"/></Border>
                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="2,0,0,0" Text="在资源管理器中显示"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Border Style="{StaticResource WsKeyCapBorder}"><TextBlock Style="{StaticResource WsKeyCapText}" Text="Space"/></Border>
                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="2,0,0,0" Text="交互大图/OCR"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Border Style="{StaticResource WsKeyCapBorder}"><TextBlock Style="{StaticResource WsKeyCapText}" Text="Ctrl"/></Border>
                    <Border Style="{StaticResource WsKeyCapBorder}"><TextBlock Style="{StaticResource WsKeyCapText}" Text="C"/></Border>
                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="2,0,0,0" Text="复制路径"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Border Style="{StaticResource WsKeyCapBorder}"><TextBlock Style="{StaticResource WsKeyCapText}" Text="Ctrl"/></Border>
                    <Border Style="{StaticResource WsKeyCapBorder}"><TextBlock Style="{StaticResource WsKeyCapText}" Text="K"/></Border>
                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="2,0,0,0" Text="回到搜索框"/>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </Grid>

        <TeachingTip x:Name="FirstRunTip" Target="{x:Bind SearchBox}" PreferredPlacement="Bottom"
                     Title="更快找到文件" IsLightDismissEnabled="True" CloseButtonContent="知道了"
                     Subtitle="Ctrl+K 随时回到搜索框；输入 type:pdf 只看某类文件；选中结果后按空格键查看页面大图。"
                     Closed="OnFirstRunTipClosed"/>
    </Grid>
</Page>
