<UserControl
    x:Class="WinSight.App.Views.SourcePreviewPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    TabFocusNavigation="Local">
    <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0" Padding="12">
        <Grid RowSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Source preview" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="SourceTitle" TextWrapping="Wrap" MaxLines="2"/><TextBlock x:Name="SourceLocation" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap"/></StackPanel>
                <Button x:Name="ClosePreview" Grid.Column="1" Click="OnClose" MinWidth="32" Padding="6" AutomationProperties.Name="Close source preview" ToolTipService.ToolTip="Close preview (Escape)"><FontIcon Glyph="&#xE8BB;"/></Button>
            </Grid>
            <ScrollViewer x:Name="PreviewScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="OnViewportSizeChanged">
                <StackPanel Spacing="12">
                    <ProgressRing x:Name="LoadingRing" IsActive="False" Visibility="Collapsed" Width="24" Height="24" HorizontalAlignment="Left" AutomationProperties.Name="Loading source preview"/>
                    <TextBlock x:Name="Notice" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    <Grid x:Name="PreviewActions" ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button x:Name="ExactOpen" Click="OnExactOpen" IsEnabled="False" MinWidth="0" HorizontalAlignment="Stretch" ToolTipService.ToolTip="Open a new read-only Office view at the indexed location" AutomationProperties.Name="Open at indexed location">
                            <TextBlock Text="Open at location" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Button>
                        <Button x:Name="OpenSourceFile" Grid.Column="1" Click="OnOpenFile" MinWidth="0" HorizontalAlignment="Stretch" AutomationProperties.Name="Open source file">
                            <TextBlock Text="Open file" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Button>
                    </Grid>
                    <CheckBox x:Name="ShowBoxes" Content="Indexed OCR line boxes" IsChecked="True" Checked="OnBoxesChanged" Unchecked="OnBoxesChanged"/>
                    <Border x:Name="RasterArea" Visibility="Collapsed" Background="{ThemeResource ControlAltFillColorSecondaryBrush}" CornerRadius="4" Height="220" Padding="4">
                        <Viewbox Stretch="Uniform">
                            <Grid x:Name="PixelFrame">
                                <Image x:Name="RasterImage" Stretch="Fill" AutomationProperties.Name="Current source page image"/>
                                <Canvas x:Name="Overlay" IsHitTestVisible="False"/>
                            </Grid>
                        </Viewbox>
                    </Border>
                    <TextBlock x:Name="BoxStatus" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap"/>
                    <ListBox x:Name="OcrLines" MaxHeight="160" SelectionChanged="OnLineSelected" AutomationProperties.Name="Indexed OCR text lines" Visibility="Collapsed"/>
                    <TextBlock Text="Indexed context" FontWeight="SemiBold"/>
                    <TextBlock x:Name="Excerpt" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.Name="Indexed source context"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
