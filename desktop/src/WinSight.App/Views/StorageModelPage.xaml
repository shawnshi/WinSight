<Page
    x:Class="WinSight.App.Views.StorageModelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="24" MaxWidth="800" HorizontalAlignment="Left">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="存储与向量模型" Style="{ThemeResource TitleTextBlockStyle}"/>
                <TextBlock Text="本地向量数据库索引统计指标与嵌入模型执行宿主运行诊断。"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- Migration Preview Banner -->
            <InfoBar IsOpen="False"
                     Visibility="Collapsed"
                     IsClosable="False"
                     Severity="Informational"
                     Title="原生预览版检索管线"
                     Message="{x:Bind ViewModel.MigrationNotice, Mode=OneWay}"/>

            <!-- Storage & Index Database Card (4-KPI Metric Dashboard) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20">
                <StackPanel Spacing="16">
                    <Grid>
                        <TextBlock Text="索引数据库状态" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                        <Border HorizontalAlignment="Right" Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="10,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B7;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{x:Bind ViewModel.DatabasePath, Mode=OneWay}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           IsTextSelectionEnabled="True"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 4-Column KPI Metric Tiles -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tile 1: Total Files -->
                        <Border Grid.Column="0" Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14,12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="已纳管文件总数" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{x:Bind ViewModel.FilesCount, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
                            </StackPanel>
                        </Border>

                        <!-- Tile 2: Indexed (Done + Partial) -->
                        <Border Grid.Column="1" Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14,12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="已完成索引入库" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{x:Bind ViewModel.IndexedAndPartialCount, Mode=OneWay}" FontSize="22" FontWeight="SemiBold"
                                           Foreground="{ThemeResource SystemFillColorSuccessBrush}" Typography.NumeralAlignment="Tabular"/>
                            </StackPanel>
                        </Border>

                        <!-- Tile 3: Pending -->
                        <Border Grid.Column="2" Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14,12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="待处理 / 队列中" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{x:Bind ViewModel.PendingCount, Mode=OneWay}" FontSize="22" FontWeight="SemiBold"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}" Typography.NumeralAlignment="Tabular"/>
                            </StackPanel>
                        </Border>

                        <!-- Tile 4: Failed -->
                        <Border Grid.Column="3" Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14,12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="解析失败 / 异常" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{x:Bind ViewModel.FailedCount, Mode=OneWay}" FontSize="22" FontWeight="SemiBold"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" Typography.NumeralAlignment="Tabular"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Full-Width Progress Bar & Status Detail -->
                    <StackPanel Spacing="6">
                        <ProgressBar Value="{x:Bind ComputePercent(ViewModel.IndexedAndPartialCount, ViewModel.FilesCount), Mode=OneWay}"
                                     Maximum="100" Height="8" CornerRadius="4"
                                     Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                     Background="{ThemeResource ControlAltFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.StatusDetail, Mode=OneWay}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Incremental Index Queue -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="增量索引任务队列" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="{x:Bind ViewModel.QueueSummary, Mode=OneWay}" TextWrapping="Wrap"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                    <TextBlock Text="{x:Bind ViewModel.QueueHealth, Mode=OneWay}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{ThemeResource CaptionTextBlockStyle}"/>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.BudgetRows, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Expander Header="查看文档提取与解析提示详情 (扫描件待 OCR / 表格结构提示)"
                              IsExpanded="False" HorizontalAlignment="Stretch"
                              Visibility="{x:Bind BoolToVisibility(ViewModel.HasFailures), Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.FailureSummary, Mode=OneWay}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{ThemeResource CaptionTextBlockStyle}" Margin="0,6,0,0"/>
                    </Expander>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="刷新队列状态" Click="OnRefreshQueueClick"
                                AutomationProperties.AutomationId="RefreshQueueStatusButton"/>
                        <Button Content="重试全部失败文件" Click="OnRetryFailedClick"
                                Style="{ThemeResource AccentButtonStyle}"
                                AutomationProperties.AutomationId="RetryFailedFilesButton"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Embedding Model Diagnostics Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="向量嵌入模型宿主" Style="{ThemeResource SubtitleTextBlockStyle}"/>

                    <TextBlock Text="向量嵌入模型宿主提供 768 维 L2 归一化向量。点击下方按钮启动宿主并校验权重指纹。"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>

                    <!-- Explicit Action Button -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="探查模型与嵌入引擎"
                                Style="{ThemeResource AccentButtonStyle}"
                                Click="OnInspectModelClick"
                                IsEnabled="{x:Bind Invert(ViewModel.IsInspecting), Mode=OneWay}"/>

                        <ProgressRing IsActive="{x:Bind ViewModel.IsInspecting, Mode=OneWay}"
                                      Width="24" Height="24"
                                      VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Error Alert -->
                    <InfoBar IsOpen="{x:Bind HasError(ViewModel.InspectionError), Mode=OneWay}"
                             Severity="Error"
                             Title="模型探查错误"
                             Message="{x:Bind ViewModel.InspectionError, Mode=OneWay}"
                             IsClosable="False"/>

                    <!-- Model Diagnostic Fields (Shown when inspected) -->
                    <Grid RowSpacing="10" ColumnSpacing="16"
                          Visibility="{x:Bind BoolToVisibility(ViewModel.HasEmbeddingInfo), Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="画像标识：" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.ProfileId, Mode=OneWay}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="向量维度：" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.Dimension, Mode=OneWay}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="运行宿主：" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.RuntimeHost, Mode=OneWay}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="模型与版本：" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.ModelName, Mode=OneWay}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="执行提供程序：" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.RequestedProvider, Mode=OneWay}"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="设备与 EP 状态：" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ViewModel.BackendStatusSummary, Mode=OneWay}" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="校验状态：" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{x:Bind ViewModel.ValidationStatus, Mode=OneWay}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Status Notice -->
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
    </ScrollViewer>
</Page>
