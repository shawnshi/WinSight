<Window
    x:Class="WinSight.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="WinSight 智寻">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt"/>
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="OnNavShortcutAccelerator"/>
            <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="OnNavShortcutAccelerator"/>
            <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="OnNavShortcutAccelerator"/>
            <KeyboardAccelerator Key="Number4" Modifiers="Control" Invoked="OnNavShortcutAccelerator"/>
            <KeyboardAccelerator Key="Number5" Modifiers="Control" Invoked="OnNavShortcutAccelerator"/>
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Custom TitleBar drag region -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent" Padding="14,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/WinSight.png" Width="16" Height="16" AutomationProperties.Name="WinSight logo"/>
                <TextBlock Text="WinSight 智寻" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="· 本地多模态智能检索" Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Main Navigation View (LeftCompact saves horizontal canvas while keeping icons + tooltips + Ctrl+1..5) -->
        <NavigationView Grid.Row="1"
                        x:Name="NavView"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="LeftCompact"
                        CompactPaneLength="48"
                        OpenPaneLength="196"
                        ItemInvoked="OnNavItemInvoked"
                        SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavSearch" Content="搜索 (Ctrl+1)" Tag="search" Icon="Find" ToolTipService.ToolTip="搜索 (Ctrl+1)"/>
                <NavigationViewItem x:Name="NavFolders" Content="目录管理 (Ctrl+2)" Tag="folders" Icon="Folder" ToolTipService.ToolTip="目录管理 (Ctrl+2)"/>
                <NavigationViewItem x:Name="NavStorage" Content="存储与模型 (Ctrl+3)" Tag="storage" Icon="Library" ToolTipService.ToolTip="存储与模型 (Ctrl+3)"/>
                <NavigationViewItem x:Name="NavMcp" Content="MCP 控制台 (Ctrl+4)" Tag="mcp" Icon="Globe" ToolTipService.ToolTip="MCP 控制台 (Ctrl+4)"/>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="NavSettings" Content="设置 (Ctrl+5)" Tag="settings" Icon="Setting" ToolTipService.ToolTip="设置 (Ctrl+5)"/>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame"/>
        </NavigationView>

        <!-- Modern Compact Bottom Status Bar -->
        <Border Grid.Row="2"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,7">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Pill Status Badge with live state color -->
                <Border Grid.Column="0" Style="{StaticResource WsPillBadgeStyle}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{x:Bind ViewModel.StatusDotBrush, Mode=OneWay}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="IndexingStateLabel"
                                   Text="{x:Bind ViewModel.IndexingStateText, Mode=OneWay}"
                                   AutomationProperties.LiveSetting="Polite"
                                   FontWeight="SemiBold"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Center: Live Progress & Stats Summary -->
                <Grid Grid.Column="1" ColumnSpacing="14" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{x:Bind FormatStats(ViewModel.DoneCount, ViewModel.FilesCount), Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Width="1" Height="13" Background="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2"
                               Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               AutomationProperties.LiveSetting="Polite"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Right: Indexing Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="PauseIndexingButton"
                            Content="{x:Bind ViewModel.PauseActionText, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.CanToggleIndexingPause, Mode=OneWay}"
                            Click="OnPauseIndexingClick"
                            AutomationProperties.AutomationId="PauseIndexingButton"
                            ToolTipService.ToolTip="暂停或恢复本次会话的索引；搜索仍保持可用"
                            CornerRadius="6" Padding="12,5"/>

                    <Button x:Name="IndexNowButton" Content="立即索引"
                            Click="OnIndexNowClick"
                            IsEnabled="{x:Bind ViewModel.CanIndexNow, Mode=OneWay}"
                            Style="{ThemeResource AccentButtonStyle}"
                            CornerRadius="6" Padding="14,5"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
