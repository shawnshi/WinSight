<Window
    x:Class="WinSight.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="WinSight (Native Migration Preview)">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Migration Preview Warning Banner -->
        <InfoBar Grid.Row="0"
                 IsOpen="True"
                 IsClosable="False"
                 Severity="Warning"
                 Title="WinSight Native Windows Migration Preview"
                 Message="Running isolated NativePreview pipeline (%LOCALAPPDATA%\WinSight\NativePreview). Legacy production pipeline and actual user indexes remain untouched."/>

        <!-- Main Navigation View -->
        <NavigationView Grid.Row="1"
                        x:Name="NavView"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        ItemInvoked="OnNavItemInvoked"
                        SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Search" Tag="search" Icon="Find"/>
                <NavigationViewItem Content="Folders" Tag="folders" Icon="Folder"/>
                <NavigationViewItem Content="Storage &amp; Model" Tag="storage" Icon="Library"/>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="settings" Icon="Setting"/>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame"/>
        </NavigationView>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Message & Summary -->
                <StackPanel Spacing="4" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="IndexingStateLabel"
                               Text="{x:Bind ViewModel.IndexingStateText, Mode=OneWay}"
                               AutomationProperties.LiveSetting="Polite"
                               Style="{ThemeResource CaptionTextBlockStyle}"/>
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Bind FormatStats(ViewModel.DoneCount, ViewModel.FilesCount), Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Indexing Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="PauseIndexingButton"
                            Content="{x:Bind ViewModel.PauseActionText, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.CanToggleIndexingPause, Mode=OneWay}"
                            Click="OnPauseIndexingClick"
                            AutomationProperties.AutomationId="PauseIndexingButton"
                            ToolTipService.ToolTip="Pause or resume indexing for this session; search remains available"
                            Padding="12,4"/>

                    <Button x:Name="IndexNowButton" Content="Index Now"
                            Click="OnIndexNowClick"
                            IsEnabled="{x:Bind ViewModel.CanIndexNow, Mode=OneWay}"
                            Style="{ThemeResource AccentButtonStyle}"
                            Padding="12,4"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
