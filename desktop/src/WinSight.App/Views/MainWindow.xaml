<Window
    x:Class="WinSight.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="WinSight 智寻 (原生预览版)">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt"/>
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Custom TitleBar drag region -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent" Padding="12,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/WinSight.png" Width="16" Height="16" AutomationProperties.Name="WinSight logo"/>
                <TextBlock Text="WinSight 智寻" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Preview status is informational; runtime failures are reported separately. -->
        <InfoBar Grid.Row="1"
                 IsOpen="True"
                 IsClosable="False"
                 Severity="Informational"
                 Title="WinSight 原生预览版"
                 Message="{x:Bind ViewModel.PreviewNotice}"/>

        <!-- Main Navigation View -->
        <NavigationView Grid.Row="2"
                        x:Name="NavView"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        ItemInvoked="OnNavItemInvoked"
                        SelectionChanged="OnNavSelectionChanged">
            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,8">
                    <Image Source="ms-appx:///Assets/WinSight.png" Width="32" Height="32"
                           AutomationProperties.Name="WinSight logo"/>
                    <TextBlock Text="WinSight" Style="{ThemeResource SubtitleTextBlockStyle}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="搜索" Tag="search" Icon="Find"/>
                <NavigationViewItem Content="目录管理" Tag="folders" Icon="Folder"/>
                <NavigationViewItem Content="存储与模型" Tag="storage" Icon="Library"/>
                <NavigationViewItem Content="MCP 控制台" Tag="mcp" Icon="Globe"/>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="设置" Tag="settings" Icon="Setting"/>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame"/>
        </NavigationView>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="3"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Message & Summary -->
                <StackPanel Spacing="4" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="IndexingStateLabel"
                               Text="{x:Bind ViewModel.IndexingStateText, Mode=OneWay}"
                               AutomationProperties.LiveSetting="Polite"
                               Style="{ThemeResource CaptionTextBlockStyle}"/>
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Bind FormatStats(ViewModel.DoneCount, ViewModel.FilesCount), Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Indexing Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="PauseIndexingButton"
                            Content="{x:Bind ViewModel.PauseActionText, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.CanToggleIndexingPause, Mode=OneWay}"
                            Click="OnPauseIndexingClick"
                            AutomationProperties.AutomationId="PauseIndexingButton"
                            ToolTipService.ToolTip="暂停或恢复本次会话的索引；搜索仍保持可用"
                            Padding="12,4"/>

                    <Button x:Name="IndexNowButton" Content="立即索引"
                            Click="OnIndexNowClick"
                            IsEnabled="{x:Bind ViewModel.CanIndexNow, Mode=OneWay}"
                            Style="{ThemeResource AccentButtonStyle}"
                            Padding="12,4"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
