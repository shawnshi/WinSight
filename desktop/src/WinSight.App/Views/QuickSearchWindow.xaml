<Window
    x:Class="WinSight.App.Views.QuickSearchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WinSight.App.ViewModels"
    mc:Ignorable="d"
    Title="WinSight 快捷搜索">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop/>
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid"
          Background="Transparent"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search Input Header (Spotlight-style borderless top bar) -->
        <Grid Grid.Row="0" Padding="18,14,14,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <FontIcon Grid.Column="0"
                      Glyph="&#xE721;"
                      FontSize="18"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                      VerticalAlignment="Center"/>

            <TextBox Grid.Column="1"
                     x:Name="SearchBox"
                     IsSpellCheckEnabled="False"
                     Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="描述内容、搜精确单号，或以 code: 搜代码 (Ctrl+O 展开主窗)…"
                     FontSize="15"
                     BorderThickness="0"
                     Background="Transparent"
                     KeyDown="OnSearchBoxKeyDown"
                     VerticalAlignment="Center"/>

            <Button Grid.Column="2"
                    ToolTipService.ToolTip="在完整窗口中打开 (Ctrl+O)"
                    Click="OnOpenInFullWindowClick"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="6" CornerRadius="6">
                <FontIcon Glyph="&#xE740;" FontSize="15"/>
            </Button>
        </Grid>

        <!-- Category Filters (SelectorBar) -->
        <SelectorBar x:Name="KindSelector" Grid.Row="1" Margin="14,0,14,8"
                     SelectionChanged="OnKindSelectorChanged"
                     AutomationProperties.Name="快捷搜索类型筛选">
            <SelectorBarItem Text="全部" Tag="all" IsSelected="True"/>
            <SelectorBarItem Text="文档" Tag="doc"/>
            <SelectorBarItem Text="PDF" Tag="pdf"/>
            <SelectorBarItem Text="图片" Tag="image"/>
            <SelectorBarItem Text="音视频" Tag="video"/>
            <SelectorBarItem Text="代码" Tag="code"/>
        </SelectorBar>

        <!-- Results Area (Master-Detail Dual Column 38% : 62%) -->
        <Grid Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3.8*" MinWidth="240"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="6.2*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Compact Results List with Inline Pill Badges -->
            <Grid Grid.Column="0">
                <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" Canvas.ZIndex="10"
                             Visibility="{x:Bind BoolToVisibility(ViewModel.IsLoading), Mode=OneWay}"/>

                <InfoBar IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
                         Severity="Informational"
                         Message="{x:Bind ViewModel.NoticeText, Mode=OneWay}"
                         IsClosable="False"/>

                <ListView x:Name="ResultsListView"
                          Padding="6"
                          ItemsSource="{x:Bind ViewModel.Hits, Mode=OneWay}"
                          SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          ItemClick="OnItemClick"
                          SelectionChanged="OnSelectionChanged"
                          ContainerContentChanging="OnResultsContainerContentChanging"
                          KeyDown="OnListViewKeyDown">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SearchItemViewModel">
                            <Grid Padding="8,7" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Width="36" Height="36" VerticalAlignment="Center">
                                    <Border CornerRadius="7"
                                            Background="{x:Bind IconBackgroundBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            Visibility="{x:Bind BadgeVisibility, Mode=OneWay}">
                                        <FontIcon Glyph="{x:Bind IconGlyph}"
                                                  FontSize="16"
                                                  Foreground="{x:Bind IconForegroundBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border CornerRadius="7" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                            Visibility="{x:Bind ThumbnailVisibility, Mode=OneWay}">
                                        <Image Source="{x:Bind ThumbnailSource, Mode=OneWay}" Stretch="Uniform" Margin="2"/>
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind FileName}"
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                   MaxLines="1"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                                                CornerRadius="8" Padding="6,1" VerticalAlignment="Center"
                                                Visibility="{x:Bind HasLocationBadge}">
                                            <TextBlock Text="{x:Bind CompactBadgeText}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Typography.NumeralAlignment="Tabular"/>
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="{x:Bind ListMetaCompact}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               MaxLines="1"
                                               TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Text="{x:Bind SubtitleText}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               MaxLines="1"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- 1px Hairline Divider -->
            <Border Grid.Column="1" Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

            <!-- Right: DigUp 4-Tier Evidence Stage (with Image & Document Raster Support) -->
            <Grid Grid.Column="2" Padding="20,16">
                <!-- Empty state when nothing is selected -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10"
                            Visibility="{x:Bind SelectedToEmptyVisibility(ViewModel.SelectedItem), Mode=OneWay}">
                    <FontIcon Glyph="&#xE721;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="即时穿透检索本地知识库" Style="{ThemeResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center"/>
                    <TextBlock Text="支持自然语言语义理解、中文分词、表格定位与代码特征 (code:)"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- 4-Tier Evidence Stage when an item is selected -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{x:Bind SelectedToDetailVisibility(ViewModel.SelectedItem), Mode=OneWay}">
                    <StackPanel Spacing="14">
                        <!-- Tier 1: Hero Evidence Canvas -->
                        <Grid>
                            <!-- Image / Screenshot Preview -->
                            <Border Visibility="{x:Bind ViewModel.SelectedItem.IsImageVisibility, Mode=OneWay, FallbackValue=Collapsed}"
                                    Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="10"
                                    MinHeight="170" MaxHeight="240" Padding="6">
                                <Image x:Name="QuickHeroImage" Stretch="Uniform" MaxHeight="224" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Paper Page Card (Documents / PDFs with Raster fallback to Excerpt) -->
                            <Border Visibility="{x:Bind ViewModel.SelectedItem.IsDocumentVisibility, Mode=OneWay, FallbackValue=Visible}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="10"
                                    MinHeight="170" MaxHeight="260" Padding="14,12">
                                <Grid>
                                    <ScrollViewer x:Name="QuickExcerptScroll" VerticalScrollBarVisibility="Auto">
                                        <TextBlock x:Name="QuickCanvasExcerptBlock"
                                                   Text="{x:Bind ViewModel.SelectedItem.CanvasExcerptText, Mode=OneWay, FallbackValue=''}"
                                                   IsTextSelectionEnabled="True" TextWrapping="Wrap"
                                                   Style="{ThemeResource BodyTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                   Margin="0,0,0,24"/>
                                    </ScrollViewer>
                                    <Image x:Name="QuickDocumentRasterImage" Stretch="Uniform" MaxHeight="230"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="9" Padding="8,2"
                                            HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                            Visibility="{x:Bind ViewModel.SelectedItem.HasLocationBadge, Mode=OneWay, FallbackValue=Collapsed}">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedItem.CompactBadgeText, Mode=OneWay, FallbackValue=''}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Code Monospace Canvas -->
                            <Border Visibility="{x:Bind ViewModel.SelectedItem.IsCodeVisibility, Mode=OneWay, FallbackValue=Collapsed}"
                                    Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="10"
                                    MinHeight="170" MaxHeight="240" Padding="16,12">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="QuickCodeExcerptBlock"
                                               Text="{x:Bind ViewModel.SelectedItem.CanvasExcerptText, Mode=OneWay, FallbackValue=''}"
                                               FontFamily="Cascadia Code, Consolas, Courier New"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               TextWrapping="NoWrap" IsTextSelectionEnabled="True"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>

                        <!-- Tier 2: 3-Line Metadata Block -->
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.SelectedItem.FileName, Mode=OneWay, FallbackValue=''}"
                                       Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind ViewModel.SelectedItem.FriendlyDirectoryPath, Mode=OneWay, FallbackValue=''}"
                                       Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind ViewModel.SelectedItem.FileMetadataLine, Mode=OneWay, FallbackValue=''}"
                                       Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>

                        <!-- Tier 3: Explainable Match Callout -->
                        <StackPanel Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE721;" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind ViewModel.SelectedItem.MatchRationale, Mode=OneWay, FallbackValue=''}"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.SelectedItem.SubtitleText, Mode=OneWay, FallbackValue=''}"
                                       Style="{ThemeResource CaptionTextBlockStyle}" MaxLines="2" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="{x:Bind ViewModel.SelectedItem.ExcerptVisibility, Mode=OneWay, FallbackValue=Collapsed}"/>
                        </StackPanel>

                        <!-- Tier 4: Dual Action Buttons -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Style="{ThemeResource AccentButtonStyle}"
                                    Click="OnQuickOpenHeroClick"
                                    CornerRadius="6" Padding="14,6"
                                    ToolTipService.ToolTip="打开至匹配位置 (Enter)">
                                <TextBlock Text="{x:Bind ViewModel.SelectedItem.PrimaryOpenLabel, Mode=OneWay, FallbackValue='打开文件'}"
                                           FontWeight="SemiBold"/>
                            </Button>
                            <Button Click="OnQuickRevealClick"
                                    CornerRadius="6" Padding="12,6"
                                    ToolTipService.ToolTip="在资源管理器中显示 (Ctrl+Enter)">
                                <TextBlock Text="在资源管理器中显示"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Footer Shortcuts Help -->
        <Border Grid.Row="3"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <Grid>
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Border Style="{StaticResource WsKeyCapBorder}"><TextBlock Style="{StaticResource WsKeyCapText}" Text="↵"/></Border>
                        <TextBlock Text="打开" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Border Style="{StaticResource WsKeyCapBorder}"><TextBlock Style="{StaticResource WsKeyCapText}" Text="Ctrl+↵"/></Border>
                        <TextBlock Text="定位" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Border Style="{StaticResource WsKeyCapBorder}"><TextBlock Style="{StaticResource WsKeyCapText}" Text="Ctrl+C"/></Border>
                        <TextBlock Text="复制路径" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Border Style="{StaticResource WsKeyCapBorder}"><TextBlock Style="{StaticResource WsKeyCapText}" Text="Ctrl+O"/></Border>
                        <TextBlock Text="展开大窗" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Border Style="{StaticResource WsKeyCapBorder}"><TextBlock Style="{StaticResource WsKeyCapText}" Text="Esc"/></Border>
                        <TextBlock Text="隐藏" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
