<Window
    x:Class="WinSight.App.Views.QuickSearchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WinSight.App.ViewModels"
    mc:Ignorable="d"
    Title="WinSight Quick Search">

    <Grid x:Name="RootGrid"
          Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search Input Header -->
        <Grid Grid.Row="0" Padding="16,16,16,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <FontIcon Grid.Column="0"
                      Glyph="&#xE721;"
                      FontSize="18"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                      VerticalAlignment="Center"/>

            <TextBox Grid.Column="1"
                     x:Name="SearchBox"
                     Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="Search files, documents, media and code..."
                     FontSize="16"
                     BorderThickness="0"
                     Background="Transparent"
                     KeyDown="OnSearchBoxKeyDown"
                     VerticalAlignment="Center"/>

            <Button Grid.Column="2"
                    ToolTipService.ToolTip="Open in Full WinSight Window (Ctrl+O)"
                    Click="OnOpenInFullWindowClick"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="6">
                <FontIcon Glyph="&#xE740;" FontSize="16"/>
            </Button>
        </Grid>

        <!-- Category Filters -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Padding="16,0,16,8">
            <Button x:Name="FilterAllBtn" Content="All" Click="OnFilterClick" Tag="all" Style="{ThemeResource AccentButtonStyle}"/>
            <Button x:Name="FilterDocBtn" Content="Docs" Click="OnFilterClick" Tag="doc"/>
            <Button x:Name="FilterPdfBtn" Content="PDF" Click="OnFilterClick" Tag="pdf"/>
            <Button x:Name="FilterImgBtn" Content="Images" Click="OnFilterClick" Tag="image"/>
            <Button x:Name="FilterVideoBtn" Content="Video" Click="OnFilterClick" Tag="video"/>
            <Button x:Name="FilterCodeBtn" Content="Code" Click="OnFilterClick" Tag="code"/>
        </StackPanel>

        <!-- Results Area -->
        <Grid Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <!-- Loading Indicator -->
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Width="36" Height="36"/>

            <!-- Notice / Status Banner -->
            <InfoBar IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
                     Severity="Informational"
                     Message="{x:Bind ViewModel.NoticeText, Mode=OneWay}"
                     IsClosable="False"/>

            <!-- Virtualized Results List -->
            <ListView x:Name="ResultsListView"
                      ItemsSource="{x:Bind ViewModel.Hits, Mode=OneWay}"
                      SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
                      SelectionMode="Single"
                      IsItemClickEnabled="True"
                      ItemClick="OnItemClick"
                      KeyDown="OnListViewKeyDown">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SearchItemViewModel">
                        <Grid Padding="12,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0"
                                      Glyph="{x:Bind IconGlyph}"
                                      FontSize="20"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                      VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind FileName}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                                               MaxLines="1"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind LocationDisplay}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="{x:Bind DirectoryPath}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           MaxLines="1"
                                           TextTrimming="CharacterEllipsis"/>

                                <TextBlock Text="{x:Bind Excerpt}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           MaxLines="1"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{x:Bind ExcerptVisibility}"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind ScoreDisplay}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Footer Shortcuts Help -->
        <Border Grid.Row="3"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <Grid>
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right">
                    <TextBlock Text="↵ Open" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="⇧↵ Reveal" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="Ctrl+C Copy" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="Esc Hide" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
