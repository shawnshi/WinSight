<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RootNamespace>WinSight.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <DefineConstants>DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <StartupObject>WinSight.App.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinSight.Core\WinSight.Core.csproj" />
    <ProjectReference Include="..\WinSight.Infrastructure\WinSight.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="[2.5.1]" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="[10.0.26100.9169]" />
  </ItemGroup>

  <Target Name="CopyWinSightLooseXaml" AfterTargets="Publish">
    <ItemGroup>
      <_WinSightLooseXaml Include="$(TargetDir)**\*.xbf" />
    </ItemGroup>
    <Error Condition="'@(_WinSightLooseXaml)' == ''" Text="WinUI compiled XBF resources are missing; refusing an incomplete native payload." />
    <Error Condition="!Exists('$(TargetDir)$(TargetName).pri')" Text="WinUI application PRI is missing; refusing an incomplete native payload." />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pri" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_WinSightLooseXaml)"
          DestinationFiles="@(_WinSightLooseXaml->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
