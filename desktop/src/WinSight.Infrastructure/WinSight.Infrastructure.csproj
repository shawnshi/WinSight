<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <SegmenterRustTarget Condition="'$(SegmenterRustTarget)' == ''">x86_64-pc-windows-msvc</SegmenterRustTarget>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../WinSight.Core/WinSight.Core.csproj" />
    <Compile Include="../../../inference/OcrIdentity.cs" Link="Shared/OcrIdentity.cs" />
    <EmbeddedResource Include="../../../inference/WinSight.OcrHost/model-manifest.json" LogicalName="WinSight.OcrHost.model-manifest.json" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="[10.0.13]" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="[3.5.1]" />
    <PackageReference Include="PdfPig" Version="[0.1.16]" />
    <!-- Chinese segmenter: the same native library must serve indexing and querying. -->
    <None Include="../../../native/winsight-segmenter/target/$(SegmenterRustTarget)/release/winsight_segmenter.dll"
          Link="runtimes/win-x64/native/winsight_segmenter.dll"
          Condition="Exists('../../../native/winsight-segmenter/target/$(SegmenterRustTarget)/release/winsight_segmenter.dll')"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
