<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RapidOcrNet.WinSight</AssemblyName>
    <PackageId>RapidOcrNet.WinSight</PackageId>
    <Version>4.2.0-winsight.1</Version>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/BobLd/RapidOcrNet</RepositoryUrl>
    <RepositoryCommit>708cae2fcb88720e1d891a81b5ee3e8b2bcc139e</RepositoryCommit>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Clipper2" Version="[2.0.0]" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="[1.31.0]" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="[1.31.0]" />
    <PackageReference Include="SkiaSharp" Version="[3.119.1]" />
  </ItemGroup>
  <ItemGroup>
    <None Update="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="NOTICE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
