<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>false</SelfContained>
    <RollForward>Disable</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAudit>false</NuGetAudit>
    <DefaultItemExcludes>$(DefaultItemExcludes);vendor/**;provenance/**;tests/**;.cache/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="vendor/RapidOcrNet/RapidOcrNet.WinSight.csproj" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="[10.0.26100.9169]" />
    <EmbeddedResource Include="model-manifest.json" />
    <None Update="model-manifest.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(OcrModelRoot)/models/v6/PP-OCRv6_det_small.onnx" Condition="'$(OcrModelRoot)' != ''" Link="models/v6/PP-OCRv6_det_small.onnx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(OcrModelRoot)/models/v6/PP-OCRv6_rec_small.onnx" Condition="'$(OcrModelRoot)' != ''" Link="models/v6/PP-OCRv6_rec_small.onnx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(OcrModelRoot)/models/v5/ch_PP-LCNet_x0_25_textline_ori_cls_mobile.onnx" Condition="'$(OcrModelRoot)' != ''" Link="models/v5/ch_PP-LCNet_x0_25_textline_ori_cls_mobile.onnx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(OcrModelRoot)/models/v6/ppocrv6_dict.txt" Condition="'$(OcrModelRoot)' != ''" Link="models/v6/ppocrv6_dict.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequirePinnedOcrAssetsForPublish" BeforeTargets="Publish">
    <Error Condition="'$(OcrModelRoot)' == ''" Text="Publishing requires explicit OcrModelRoot with the four pinned OCR assets; no download/default fallback." />
  </Target>
</Project>
